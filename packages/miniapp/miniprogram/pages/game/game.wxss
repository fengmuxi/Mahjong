.game {
  /* 横向 padding 吃进刘海 / 挖孔内缩。两个来源取大者（max）：
     ① var(--safe-l/r)：computeSafeInsets 用「探测元素」量出的 env() 真实值 +
        wx.getWindowInfo().safeArea（部分安卓机型横屏只认这个）；
     ② env(safe-area-inset-left/right)：iOS 横屏的可靠来源。
     无刘海 / 挖孔设备两者都是 0px，布局与原样一致。
     **顶部同理**（--safe-t）：navigationStyle=custom 后页面铺满全屏，自绘顶栏
     必须自己避开系统状态栏（安卓横屏 ~24px，iOS 横屏 0）。底部安全区仍走 env()。 */
  padding-top: calc(4px + max(var(--safe-t, 0px), env(safe-area-inset-top, 0px)));
  padding-right: calc(16rpx + max(var(--safe-r, 0px), env(safe-area-inset-right, 0px)));
  padding-bottom: calc(12rpx + env(safe-area-inset-bottom, 0px));
  padding-left: calc(16rpx + max(var(--safe-l, 0px), env(safe-area-inset-left, 0px)));
  height: 100vh;
  display: flex;
  flex-direction: column;
  /* 浮层的定位基准：.layer 在 game 页改为 absolute（见下），必须有个 relative 祖先 */
  position: relative;
}

/*
 * 浮层定位（2026-10-17 修）：
 * app.wxss 的 .layer 是 position:fixed + inset:0 弹性居中，基准是小程序**文档**而非
 * 可视区 —— 本页 .game 高 100vh（含导航栏区），文档比可视区高出一截，fixed 卡片
 * 实测比屏心低 ~23 CSS px、左 ~34 CSS px（横向偏移疑与页面溢出/滚动有关）。
 * 改为 absolute + inset:0：基准变成 .game 的 padding box（上面已加 position:relative），
 * 即本页整个可视流区，卡片随之精确居中；导航栏是原生 UI 在流区之外，本就无需 Dim。
 * 注意只覆盖 game 页：lobby 页仍用 app.wxss 的 fixed 版。
 */
.game .layer {
  position: absolute;
}

/* ---------- 整屏桌面（2026-10-22） ---------- */
/*
 * 用户参考图（源项目 liumengniu/majiang 的对局画面）里，绿绒龙纹桌是**铺满整屏**的，
 * 手牌直接坐在桌上；而本页原来的桌面是 canvas 里的一张贴图 —— 画布 2:1 又被行高
 * 卡成手机横屏宽度的 ~65%，左右两条深色空白里飘着按钮轨，观感像「一张牌桌摆在黑屋子里」。
 *
 * 现在：这一层 DOM 铺整页（`<image mode="scaleToFill">`），canvas 里画同一张图的同一块
 * （table.js 的 drawTable 按 `frame` 矩形铺），两层映射完全一致 → 画布矩形内由 canvas 画、
 * 矩形外由 DOM 画，接缝不可见。**两边都必须是「非等比整铺」**：
 * 换成 cover/等比会裁边，2:1 的图铺 2.16:1 的横屏会把上下木框各裁掉一截，只剩左右两条竖框。
 * canvas 那边同样按整铺算，不要改成 cover。
 *
 * 为什么不能干脆把 canvas 拉满整屏：<canvas type="2d"> 是原生组件，会压住其矩形内的
 * 所有 DOM（手牌条、按钮轨都会看不见点不着），所以 canvas 只能占中间那块，
 * 桌面靠「DOM 铺外圈 + canvas 铺内圈」拼出来。
 */
.felt {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 0;
  pointer-events: none;
  /* 兜底色 = 桌面贴图绒布的平均色（采样 table.webp：#116347~#186f4f 之间）——
     图片还在路上时铺的就是它，不会先闪一块黑。 */
  background-color: #14614a;
  /* <image mode="scaleToFill"> 铺满（非等比拉伸，与 canvas 侧 drawImage 的整铺映射一致） */
  display: block;
  width: 100%;
  height: 100%;
}

/* UI 整通道拿不到（清单空 / 请求失败）：退成矢量桌的外层藏青，见 game.js 的 loadUiArt */
.felt.na {
  background-color: #0d1626;
}

/* 桌面之上的所有内容都要显式抬一层，否则会被 .felt 盖住（同为普通 DOM，按 z-index 排） */
.g-top,
.banner,
.game-main,
.board-overlay {
  position: relative;
  z-index: 1;
}

/* ---------- 自绘顶栏（navigationStyle=custom） ---------- */
/*
 * 2026-10-21 布局重排（用户报「牌面区域小、功能都挤在顶部」）。
 * 改前：原生导航栏（44px）+ HUD 一行（玩法/房间/牌墙/精 + 4 枚功能钮）≈ 74px 高度，
 * 牌桌一寸都沾不到。改后：合成一行 28px 的极简信息条，功能钮全部迁到左右侧边轨
 * （.rail），牌桌高度净赚 ~44px、宽度净赚两条侧栏（PC 宽窗约 400px）。
 * 高度与 game.js 的 TOPBAR_H 必须一致（estimateWrap 的兜底估算要用）。
 */
.g-top {
  display: flex;
  align-items: center;
  gap: 10rpx;
  height: 28px;
  margin-bottom: 2px;
  flex-shrink: 0;
  min-width: 0;
}

.g-top-back {
  width: 26px;
  height: 26px;
  line-height: 24px;
  text-align: center;
  font-size: 18px;
  color: #f6e3a1;
  border: 1px solid rgba(255, 255, 255, 0.18);
  border-radius: 8rpx;
  background: rgba(16, 26, 21, 0.7);
  flex-shrink: 0;
}

.g-top-info {
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-width: 0;
  flex: 1;
  overflow: hidden;
  white-space: nowrap;
}

/* 右侧避让系统胶囊（⋯ ○）：CAPSULE_W 与 game.js 常量一致 */
.g-top-cap {
  width: 118px;
  flex-shrink: 0;
}

.g-top-item {
  font-size: 11px;
  color: #b9cfc2;
  min-width: 0;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* jingText 很长（赣州：「正精 北 · 副精 东（其余 10 张结算揭晓）」）→ 单独一色 + 省略号 */
.g-top-item.jing {
  color: #e0a86a;
}

.g-top .badge {
  font-size: 10px;
  padding: 1px 8px;
  flex-shrink: 0;
}

.g-top .code {
  font-size: 11px;
  flex-shrink: 0;
}

/* ---------- 侧边按钮轨（rail） ---------- */
/*
 * 左右各一列 36px 的浮层按钮，absolute 贴在 .game-main 两缘、垂直居中。
 * **绝不占流宽、也绝不压画布**：fitCanvas 的 min(行宽 − 84, 行高×2) 保证画布两侧
 * 各留 ≥ 42px 空白；原生 canvas 合成层级高于 DOM，压在画布上的钮会被盖住点不到
 * （2026-10-17 实测 cover-view 都盖不住 canvas，详见 §10.8⑦）。
 * 手机横屏画布被行高卡住（宽有富余）→ 轨落在纯空白区；宽窗口画布吃宽度 → 让出的
 * 84px 正好归轨。骰子阶段整轨隐藏（diceShown，覆盖层已盖满全页）。
 */
.rail {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  display: flex;
  flex-direction: column;
  gap: 8px;
  z-index: 5;
}

.rail-l {
  left: 2px;
}

.rail-r {
  right: 2px;
}

.rail-btn {
  width: 36px !important;
  height: 36px;
  line-height: 34px;
  padding: 0;
  text-align: center;
  font-size: 17px;
  border-radius: 999px;
  color: #e8e2cf;
  background: rgba(16, 26, 21, 0.82);
  border: 1px solid rgba(255, 255, 255, 0.16);
  position: relative;
  flex-shrink: 0;
}

/* 面板打开态 / 托管激活态：金底（与参考图右列同款） */
.rail-btn.on {
  background: rgba(230, 193, 75, 0.22);
  border-color: rgba(230, 193, 75, 0.85);
  color: #f6e3a1;
}

.rail-btn.danger {
  color: #e07a6a;
  border-color: rgba(224, 122, 106, 0.5);
}

/* 未读红点：贴在聊天钮右上角 */
.rail-badge {
  position: absolute;
  top: -2px;
  right: -2px;
  min-width: 16px;
  height: 16px;
  line-height: 16px;
  padding: 0 3px;
  border-radius: 999px;
  background: #e5484d;
  color: #fff;
  font-size: 10px;
  font-weight: 700;
}

/* ---------- 记录 / 聊天弹层面板 ---------- */
/*
 * 面板是 .game-main 的**子元素**（absolute inset:0）而不是 .game 的：
 * .game-main 正好就是「牌桌区」，面板盖上去不遮底部手牌条 —— 看记录/聊天时
 * 牌局还在走，手牌必须留着能出。配合 panelOpen 把 canvas 切 display:none
 * （原生组件合成层级在 DOM 之上，不藏面板会被牌桌盖住），与 .on-modal 同机制。
 */
.side-panel {
  position: absolute;
  inset: 0;
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(6, 10, 16, 0.55);
  border-radius: 12rpx;
}

.panel-card {
  width: min(72vw, 560px);
  max-height: 100%;
  display: flex;
  flex-direction: column;
  background: rgba(16, 26, 21, 0.97);
  border: 2rpx solid rgba(255, 255, 255, 0.16);
  border-radius: 14rpx;
  overflow: hidden;
  box-shadow: 0 10px 28px rgba(0, 0, 0, 0.45);
}

.chat-card {
  width: min(64vw, 480px);
}

.panel-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  padding: 6px 10px;
  border-bottom: 2rpx solid rgba(255, 255, 255, 0.08);
  flex-shrink: 0;
}

.panel-title {
  font-size: 13px;
  color: #f6e3a1;
  font-weight: 700;
}

.panel-x {
  width: 26px !important;
  height: 26px;
  line-height: 24px;
  padding: 0;
  text-align: center;
  font-size: 13px;
  color: #9db5a8;
  background: transparent;
}

.panel-body {
  flex: 1;
  min-height: 0;
  padding: 6px 10px;
}

/* ---------- 牌桌行 ---------- */
/*
 * 2026-10-21：三栏（记录 | 画布 | 聊天）废除，画布独占整行；记录/聊天改成左右
 * 侧边钮 + 弹层面板（见上方 .rail / .side-panel），所以这里**不再有 gap**，
 * 也不需要再和 JS 常量对齐侧栏宽。position:relative 是 .rail/.side-panel 的定位基准。
 */
.game-main {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: row;
  position: relative;
}

/*
 * 画布贴操作区底边（2026-10-20 出血对齐）：画布在「行宽 < 行高×2」时高度吃不满
 * wrap（宽约束），原来垂直居中会上下都留 felt 空隙、与手牌条隔着一条缝；
 * 改 flex-end 让牌桌坐在手牌条正上方（无垂直余量时与原来完全一致 —— 手机横屏
 * 常态就是这种：canvasH = 行高，改动零表现）。
 */
.canvas-wrap {
  flex: 1;
  min-width: 0;
  min-height: 0;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  position: relative;
}

/*
 * 画布自身不再带 border-radius（2026-10-22）：桌面现在是**整屏**的（见 .felt），
 * 画布只是桌面中间的一扇窗，给画布倒角等于在绿绒桌中间抠出一个圆角矩形，
 * 而且画布四角露出的是 DOM 底色，与 canvas 里同图不同源，会有一圈色差。
 * display:block 不能省 —— canvas 是行内元素，行内会有基线空隙、画布高度被撑大。
 */
.canvas-wrap canvas {
  display: block;
}

/*
 * 浮层打开期间藏掉牌桌画布（JS 侧 modalOpen → on-modal）。
 * 原因：<canvas type="2d"> 是原生组件，合成层级在 DOM 之上 —— fixed 的 .layer
 * Dim 不到它、盖不住它，且浮层打开时牌桌仍会被穿透点击（能点牌出牌）。
 * 用 class 切 display 而非 wx:if：后者会销毁 canvas 节点，this.table 实例
 * 与已绘牌面一起失效。关闭时 syncModal 里会补 render + fitCanvas。
 */
.canvas-wrap canvas.on-modal {
  display: none;
}

/*
 * 底部操作区：提示 → 吃碰杠胡 → 手牌，在画布下方**流内**排布。
 * （曾试图用 cover-view 盖在牌桌下缘，2026-10-17 实测否决：开发者工具里 cover-view
 *  同样盖不住原生 canvas —— 实时 DOM 里整块操作区都渲染了却完全不可见。详见 §10.8⑦。）
 * **不要在这里再写 padding-bottom: env(safe-area-inset-bottom)** —— `.game` 的底部内边距
 * 已经算过一份，再加一份会让底部多空出 ~21px（横屏 home indicator），那段高度本该归画布。
 */
.board-overlay {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex-shrink: 0;
}

/*
 * 刘海/挖孔探测元素（computeSafeInsets 用）：宽/高直接写成 env(safe-area-inset-left/right/top)，
 * SelectorQuery 量它的宽/高 = 当前运行时里 env() 的真实解析值。0 尺寸 + absolute + 不可见，
 * 不占布局、不挡点击。`#safe-probe-l/r` 写 width（横向量），`#safe-probe-t` 写 height（顶部量）。
 */
.safe-probe {
  position: absolute;
  left: 0;
  top: 0;
  height: 0;
  visibility: hidden;
  pointer-events: none;
}

#safe-probe-l {
  width: env(safe-area-inset-left, 0px);
}

#safe-probe-r {
  width: env(safe-area-inset-right, 0px);
}

#safe-probe-t {
  width: 0;
  height: env(safe-area-inset-top, 0px);
}

/*
 * 提示浮层（事件/错误 toast）在局内改到手牌条（出牌器）**上方**——
 * app.wxss 的 `.toast` 是 fixed bottom:40rpx，正好压在手牌条上（用户截图红框）。
 * fixed 相对视口定位，bottom 要跨过整个操作区：状态行 32rpx + 间距 4rpx
 * + 手牌条 96rpx + 页脚 padding 12rpx + 间隙 12rpx ≈ 156rpx。
 * 浮层盖住的是牌桌下沿的牌河（提示 3s 自动消失，不常驻）。
 * 手机横屏紧凑档的 px 精确定位在下方 media 块里。
 */
.toast {
  bottom: 156rpx;
}

/* ---------- 局内聊天（只在侧边弹层面板里出现，2026-10-21） ---------- */
/*
 * 聊天从「流内右列 / HUD 圆钮展开」并入侧边轨 💬 弹窗（.panel-card.chat-card）。
 * 这里只留面板内部用的样式：消息区 + 快捷语/表情 + 输入行。
 */
.chat {
  min-width: 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.chat-log,
.log-list {
  flex: 1;
  min-height: 0;
  max-height: 300rpx;
  padding: 8rpx 12rpx;
}

.chat-msg {
  font-size: 22rpx;
  line-height: 1.6;
  word-break: break-all;
}

.chat-msg.self .chat-name {
  color: #f6e3a1;
}

.chat-name {
  color: #9db5a8;
}

.log-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 20rpx;
  padding: 3rpx 0;
}

.log-seat {
  color: #9db5a8;
  min-width: 96rpx;
}

.log-action {
  padding: 0 10rpx;
  border-radius: 6rpx;
  background: rgba(255, 255, 255, 0.08);
}

.log-action.hu {
  background: rgba(229, 72, 77, 0.25);
  color: #ef9a9a;
}

.log-action.gang,
.log-action.angang,
.log-action.bugang {
  background: rgba(255, 152, 0, 0.22);
  color: #ffb74d;
}

.log-action.peng {
  background: rgba(33, 150, 243, 0.22);
  color: #64b5f6;
}

.log-action.chi {
  background: rgba(76, 175, 80, 0.22);
  color: #81c784;
}

/* 快捷语 / 表情：scroll-view 才能真正滚动（普通 view 的 overflow 不生效） */
.chat-pop {
  max-height: 200rpx;
}

.chat-pop-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  padding: 8rpx 12rpx;
}

.chat-chip {
  height: 52rpx;
  line-height: 48rpx;
  font-size: 22rpx;
  padding: 0 14rpx;
}

.chat-input-row {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 8rpx 10rpx;
  border-top: 2rpx solid rgba(255, 255, 255, 0.08);
}

.chat-ico {
  /* !important 同上：破内置 184px 定宽 */
  width: 52rpx !important;
  height: 52rpx;
  line-height: 48rpx;
  padding: 0;
  text-align: center;
  font-size: 24rpx;
}

.chat-input {
  flex: 1;
  /* input 默认有 ~150px 的固有宽度，不给 min-width:0 会把「发送」挤出侧栏 */
  min-width: 0;
  height: 52rpx;
  padding: 0 12rpx;
  border-radius: 8rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.14);
  background: rgba(0, 0, 0, 0.25);
  color: #e8efe9;
  font-size: 22rpx;
}

.chat-send {
  height: 52rpx;
  line-height: 48rpx;
  font-size: 22rpx;
  padding: 0 16rpx;
}

/* ---------- 画布下方的操作区（提示 / 控件 / 手牌） ---------- */
/*
 * 状态行恒占一行：左文案 + 右倒计时。**不要用 wx:if 增删这一行** ——
 * 一增一删会让操作区总高变化，画布随之重排跳动（用户报「报杠提示把牌桌往上顶」）。
 * 高度锁死 + 文案省略号，保证任何状态下总高都不变。
 */
.g-status {
  width: 100%;
  height: 32rpx;
  line-height: 32rpx;
  margin: 2rpx 0;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.g-status-text {
  font-size: 24rpx;
  color: #e8efe9;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  flex-shrink: 1;
  min-width: 0;
}

/*
 * 结算态的状态行：手牌带退场后这块就是操作区的全部内容，可以放宽一点
 * 让胡牌结果和「本局结算 ▲」都看得清。高度变化发生在「进入/离开结算」这一帧，
 * JS 侧 chromeKey 翻转会补一次 fitCanvas()，画布跟着重排，不会留下空隙。
 */
.g-status.over {
  height: 44rpx;
  line-height: 44rpx;
}

.g-status.over .g-status-text {
  font-size: 26rpx;
  color: #f6e3a1;
}

/* 听牌提示（2026-10-23）：与倒计时同款小胶囊，挂在状态行右侧。
   内容由服务端 view.waits 决定（能自摸胡的进张），前端不判规则。
   高度必须 ≤ 状态行高度（常态 32rpx / 紧凑档 15px），否则会被 overflow:hidden 裁掉。 */
.waits-chip {
  margin-left: 10rpx;
  padding: 0 12rpx;
  border-radius: 999rpx;
  background: rgba(230, 193, 75, 0.18);
  border: 1px solid rgba(230, 193, 75, 0.7);
  color: #f6e3a1;
  font-size: 22rpx;
  line-height: 30rpx;
  white-space: nowrap;
  flex-shrink: 0;
}

/* 响应倒计时：并进状态行（原先绝对定位在画布顶部，会被原生 canvas 盖住） */
.countdown {
  margin-left: 10rpx;
  padding: 0 10rpx;
  border-radius: 999rpx;
  background: rgba(0, 0, 0, 0.45);
  color: #f6e3a1;
  font-size: 22rpx;
  line-height: 30rpx;
  white-space: nowrap;
  flex-shrink: 0;
}

/* 错误提示：占位替换状态文案（同一行），不再单独占一行 —— 否则一出现就把
   操作区顶高、画布重排（线上旧服务端每 10s 回一次「未知消息」时最明显）。 */
.g-status-text.err {
  color: #e07a6a;
}

.controls {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
}

/*
 * 操作钮艺术图变体（2026-10-21 起，2026-10-23 补齐吃/暗杠/自摸/展示）：
 * 吃/碰/杠/胡/过 全走 CDN 位图（utils/uiart.js），图上再压一行小注（牌名/牌型）。
 * 设计约束：
 *   · 总高 ≈ 图高（小注用负边距压回图下缘）—— claim-mask 与手牌条同高，
 *     顶出去的部分会被原生 canvas 合成层挡住（真机实测 cover-view 都盖不住 canvas）；
 *   · display/margin 要压 app.wxss 的全局 `button{}` !important 四条；
 *   · 清单未就绪时类里没有 .art，整块退回上面的文字钮。
 */
.ctrl.art {
  display: block !important;
  height: auto;
  line-height: 1;
  padding: 0;
  border: 0;
  background: transparent;
  margin: 1px 4px !important;
}
/*
 * 2026-10-23 用户报「操作按钮显示太大、底部信息显示不全」：图标原来用 rpx
 * （92×78rpx），在宽而矮的横屏窗口里 1rpx 被放大到 1.3~2.5px，图标长到
 * 100~235px，远超 66px 的手牌和 68px 的遮罩，caption 被顶出屏幕。
 * 改为 px 定尺（375px 宽基准），再用 max-* 挂回 rpx —— 窄屏仍按比例缩，
 * 宽屏不再放大。宽高上限同比例（2rpx:1px），不会拉变形。
 */
.ctrl.art .ctrl-img {
  display: block;
  width: 46px;
  max-width: 92rpx;
  height: 39px;
  max-height: 78rpx;
  margin: 0 auto;
}
.ctrl.art .ctrl-cap {
  display: block;
  margin: -6px auto 0;
  padding: 0 4px;
  max-width: 54px;
  border-radius: 999rpx;
  background: rgba(8, 12, 18, 0.72);
  color: #f2e6c8;
  font-size: 9px;
  line-height: 10px;
  text-align: center;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/*
 * 同屏 ≥7 个钮时的**全体小号**（2026-10-23）：7 个钮（吃 3 组 + 碰/杠/胡 + 过）按
 * 46px 排一行要 7×(46+8) = 378px > 375px 基准，必然换行并顶出 claim-mask（实测溢出
 * 16~21px）。**必须全体一起缩** —— 只缩吃钮会让同屏图标大小不一（用户报「有的显示
 * 更大有的更小」）。38px 时 7×(38+8) = 322px < 375px，一行放得下。
 */
.ctrl.art.compact .ctrl-img {
  width: 38px;
  max-width: 76rpx;
  height: 32px;
  max-height: 64rpx;
}
.ctrl.art.compact .ctrl-cap {
  margin-top: -5px;
  padding: 0 3px;
  max-width: 43px;
  font-size: 8px;
  line-height: 9px;
}

/* 结算艺术字：面板标题上方的胜利/失败/平局（CDN；未就绪整块不渲染） */
.settle-art {
  display: block;
  width: 320rpx;
  height: 178rpx;
  margin: 0 auto 6rpx;
}

/* ---------- 报杠行（2026-10-23） ----------
   位置：手牌条正上方（WXML 里排在 .tray-stack 之前）。
   **整行只在「本玩法支持报杠 + 确实有可报牌面」时渲染**（用户要求），其余情况不占高度；
   显隐改变了操作区总高，所以 renderGame 把它并进 chromeKey，翻转那一帧才 fitCanvas 重量
   —— 否则画布按旧行高定尺会溢出 .canvas-wrap（flex-end 对齐会往上顶、压到顶栏）。
   可见时行高固定 56rpx：按钮数量变化（1~4 个）不改变行高，同一回合内不会来回抖。
   多张可报时横向排开（真实上限 4 个：13 张手牌最多凑 4 组三张），一行放得下；
   overflow:hidden 兜住极端情况，宁可裁一点也不要换行。
   胶囊用**纯文字**（「报杠 四萬」）：24px 高的小钮里放书法体「杠」位图会糊成一团。 */
.declare-row {
  width: 100%;
  height: 56rpx;
  margin-bottom: 4rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  overflow: hidden;
}

.declare-btn {
  height: 48rpx;
  padding: 0 16rpx;
  font-size: 22rpx;
  line-height: 1;
  border-radius: 999rpx;
  flex-shrink: 0;
  /* 同样要压过 app.wxss 的 button{display:inline-block!important}，
     否则内容按行内基线排、上下留白不均 */
  display: inline-flex !important;
  align-items: center;
  justify-content: center;
  background: rgba(230, 193, 75, 0.18);
  border: 1px solid rgba(230, 193, 75, 0.85);
  color: #f6e3a1;
  white-space: nowrap;
}

/* 无可报牌面时整行不渲染（用户要求），因此这里不再需要灰底占位钮样式 */

.declare-btn[disabled] {
  opacity: 0.45;
}

/* 操作区容器：手牌与遮罩共用同一块区域，遮罩绝对定位盖在手牌上。
   min-height 与手牌条同高 —— 万一某状态下手牌没渲染，遮罩也要有落脚空间。
   结算态整块不渲染（WXML overPhase），高度归还画布。 */
.tray-stack {
  position: relative;
  width: 100%;
  min-height: 68px;
  display: flex;
  justify-content: center;
}

/*
 * 吃碰杠胡遮罩：半透明盖在手牌上，手牌仍可见（用户要看牌决定碰还是胡）。
 * 遮罩与手牌都是普通 DOM —— DOM 之间互相覆盖不受原生 canvas 限制（canvas 只挡在
 * 它自己的矩形上方，操作区已在画布下方）。
 */
.claim-mask {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  top: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: rgba(8, 18, 13, 0.62);
}

/* 遮罩里的按钮自带外观（半透明底上要保证可辨识） */
.controls button {
  height: 30px;
  line-height: 28px;
  font-size: 12px;
  padding: 0 10px;
  margin: 2px 3px;
}

/*
 * 结算入口「本局结算 ▲」：挂在状态行**最右侧**，与结果文案同一行。
 * 原先它是操作区的第一个子元素（独占一行、紧贴画布底边，下面再接结果文案），
 * 视觉上像被挤在牌桌和文案之间 —— 用户报「本局结算显示位置异常」。
 * 高度必须 ≤ 状态行高度（常态 32rpx / 紧凑档 15px；结算档 `.g-status.over`
 * 44rpx / 22px），否则会被 .g-status 的 overflow:hidden 裁掉一半。
 */
.settle-restore {
  margin-left: 12rpx;
  padding: 0 16rpx;
  height: 30rpx;
  line-height: 30rpx;
  border-radius: 999rpx;
  background: rgba(230, 193, 75, 0.92);
  color: #22200f;
  font-size: 20rpx;
  white-space: nowrap;
  flex-shrink: 0;
}

/* 手牌（scroll-view 横向滚动；窄屏靠 max-width 档缩牌面兜底） */
.hand-tray {
  width: 100%;
  display: flex;
  justify-content: center;
  /* scroll-view 横向滚动；内容不足时由内层 .tray-row 居中 */
  white-space: nowrap;
}

.hand-tray.active .tile-btn {
  border-color: rgba(230, 193, 75, 0.9);
}

.tray-row {
  display: flex;
  /* scroll-x 里必须单行：靠溢出横向滚动，不能 wrap */
  flex-wrap: nowrap;
  /*
   * 2026-10-21 **局中居中对齐**（用户报「手牌应该局中对齐」）。
   * 之前是 space-between「出血对齐」——但条宽是按 14 张满编预算的（handTrayW =
   * max(画布宽, 14 张需求)）：有副露时手上只剩 7~10 张，space-between 把空余全摊到
   * 牌缝里，真机实测 7 张牌被 57px 的大间隙拉散（截图 1016 图素里只有 7 组牌）。
   * 现在双保险居中，两条路径都通向同一个中心轴：
   *   ① width:max-content + margin:0 auto —— 行收缩到内容宽，auto 外边距在条内居中；
   *      内容超宽（iPad 分屏这类真要横滑的极端窄窗）时过约束 → 外边距归 0，
   *      行从左端起排，滚动行为不变（若用 center 居中溢出会左右都溢出、左边滚不到）。
   *   ② justify-content:center —— 万一某台老 webview 不支持 max-content，行仍是整条宽，
   *      靠 flex 居中同样把牌群聚在中间，绝不回到「摊大饼」。
   * 牌群在条内居中 → 条由 board-overlay 的 margin:0 auto 与画布同中心轴（见 WXML）。
   */
  width: max-content;
  margin: 0 auto;
  justify-content: center;
  padding: 1px 0;
  /*
   * 2026-10-21：3D 后仰已废除（用户要「手牌是正的」，见 .tile-btn）。
   * 这一层现在只剩布局职责，不再有任何 transform / perspective。
   */
}

/*
 * 手牌牌面**正视**（2026-10-21，用户报「手牌上的牌上小下大」）。
 * 2026-10-18 引入的 3D 后仰（perspective + rotateX(16°)）让每张牌都是上窄下宽的
 * 梯形 —— 用户要的是「正的」，所以 transform 整条去掉，只保留阴影的层次感。
 * 透视距离变量（CSS 自定义属性）与 handMetrics 的 handPersp 一并废除（无消费者）。
 */
.tile-btn {
  box-shadow: 0 3px 7px rgba(0, 0, 0, 0.34), 0 1px 2px rgba(0, 0, 0, 0.26);
}

.tile-btn:active {
  box-shadow: 0 5px 10px rgba(0, 0, 0, 0.42), 0 1px 3px rgba(0, 0, 0, 0.32);
}

/*
 * ===== 手牌牌位：**px 定尺 + 按条宽自适应**（2026-10-21 修「手牌为啥还能滑动」）=====
 *
 * 演进（三次事故，都是同一个病根：两个真相）：
 *   ① 76rpx×92rpx 配 rpx 字号 —— rpx 基准是窗口宽，牌位随窗口放大到 131×158，
 *      还被 aspectFill 上下裁 8.4%（「牌面被切」）。
 *   ② px 定尺 46×66 + px 字号 —— 裁切治好了，但手牌条宽度绑 canvasW（画布 2:1 反算），
 *      手机横屏画布只有 ~410px，14 张要 679px → 必须横向滚动（「还能滑动」）。
 *   ③ 现在：尺寸/字号的**上限**仍是 46×66 / 25·12·27（全档统一 px），但由 fitCanvas
 *      的 handMetrics 按实测行宽算出实际值，经 CSS 变量（牌宽、牌高、摸牌左距、
 *      三个字号、透视距离）写到 .tray-row 上；条不够宽就整排同比缩小，
 *      绝不再出现「放不下只能滚」。
 *      ⚠️ 注释里**不要写出这几个变量的连写形式**（形如 --a/--b/--c）：其中的
 *      「星斜杠」会把注释提前闭合，后面整条规则会被当成无效选择器丢掉 ——
 *      2026-10-21 实测翻车过一次，症状是「设了变量但牌位毫无变化」。
 *
 * 变量默认值 = 上限值：首帧还没量到布局、或极端窄窗缩到 HAND_MIN_W 之前，观感一致。
 * **不要再往 @media 档里写第二份尺寸**（③之前的 ≤700px 档就是那么翻车的）——
 * 自适应已经覆盖了所有宽度，断点档只该管高度/字号以外的布局。
 */
.tile-btn {
  width: var(--tw, 46px);
  height: var(--th, 66px);
  /*
   * border-box：`--tw` 必须是牌的**真实外宽**。改前是 content-box，46px 的 width
   * 外加 1px 边框 → 实际占 48px，而 handMetrics 按 46 算，14 张恰差 28px 排不进条宽
   * （2026-10-21 实测）。边框归位后「牌宽 = --tw」，算式与渲染逐像素一致。
   */
  box-sizing: border-box;
  margin: 0 1px;
  /*
   * 2026-10-20：**不许被压缩**。之前 overflow 时 flex 默认 shrink 会把牌挤成
   * 十几像素宽的细条（用户报「手牌显示异常」：中间几张筒变成竖细条）——
   * 现在条宽由 handMetrics 保证排得下，这里是双保险。
   */
  flex-shrink: 0;
  border-radius: 4px;
  background: #f8f5ec;
  border: 1px solid #c9c2b0;
  display: flex;
  /* 牌面是矢量文字：数牌两行（数字在上、花色在下），风箭牌一行大字 */
  flex-direction: column;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  position: relative;
}

.tile-btn.drawn {
  margin-left: var(--ml-drawn, 8px);
  border-color: #e6c14b;
}

.tile-btn.frozen {
  border-color: #e6c14b;
  opacity: 0.75;
}

.tile-btn.must {
  border-color: #e05a4a;
}

/*
 * 精边框（正精橙 / 副精紫）优先级最高：出牌阶段 `.hand-tray.active` 会把所有手牌描成
 * 金色边框（特异度同为 0,2,1，但这两条在它后面 → 覆盖金色），`.drawn`/`.frozen`/`.must`
 * 特异度更低也会被覆盖 —— 「这是精」比「刚摸/金框/强制出牌」的信息更重要（2026-10-18）。
 */
.hand-tray .tile-btn.fu {
  border-color: #ab47bc;
}

.hand-tray .tile-btn.pi {
  border-color: #ff5722;
}

/*
 * 牌面（2026-10-18 起代码包零图片）：
 *   · **优先 CDN 图片**（`.tile-img` 铺满牌位），地址由后端 `/api/tiles` 清单给出；
 *   · 没取到清单 / 单张加载失败 → 矢量文字兜底：数牌两行（数字在上、花色在下），
 *     风箭牌一行大字。色调按花色区分，小尺寸下靠颜色分辨。
 * 为什么要兜底：官方体检「图片资源 ≤ 200KB、主包 < 1.5MB」，牌面只能走网络，
 * 而域名可能没登记、网络可能不通 —— 兜底保证任何时候牌都看得见。
 */
.tile-img {
  width: 100%;
  height: 100%;
}
.tile-rank {
  /* 三个字号与牌位同比例（handMetrics 的 k），永远装得进牌面 */
  font-size: var(--fs-rank, 25px);
  font-weight: 700;
  line-height: 1;
  color: #1a1a2e;
}

.tile-suit {
  font-size: var(--fs-suit, 12px);
  font-weight: 700;
  line-height: 1;
  margin-top: 1px;
  color: #1a1a2e;
}

.tile-honor {
  font-size: var(--fs-honor, 27px);
  font-weight: 700;
  line-height: 1;
  color: #1a1a2e;
}

/* 万：数字墨色 + 萬字红色（与真实牌面同色系）；条全绿、筒全蓝 */
.tone-m .tile-suit {
  color: #c62828;
}

.tone-s .tile-rank,
.tone-s .tile-suit {
  color: #1b7f3b;
}

.tone-p .tile-rank,
.tone-p .tile-suit {
  color: #1f5fbf;
}

.tone-zhong .tile-honor {
  color: #c62828;
}

.tone-fa .tile-honor {
  color: #1b7f3b;
}

.tone-bai .tile-honor {
  color: #1f5fbf;
}

/* ---------- 表情 / 结算（页内浮层） ----------
   掷骰覆盖层已搬到 app.wxss + templates/dice.wxml（对局页与大厅页共用）。 */
.emote-card {
  width: 640rpx;
}

.emote-targets {
  display: flex;
  gap: 10rpx;
  flex-wrap: wrap;
  margin-bottom: 12rpx;
  /* 2026-10-23 居中：面板是宽卡片，目标钮不足一行时靠左会与下面居中的表情格子错开 */
  justify-content: center;
}

.emote-target {
  height: 60rpx;
  line-height: 56rpx;
  font-size: 22rpx;
  padding: 0 16rpx;
}

.emote-target.on {
  background: rgba(230, 193, 75, 0.18);
  color: #f6e3a1;
  border-color: #e6c14b;
}

.emote-grid {
  max-height: 320rpx;
}

.emote-group {
  font-size: 22rpx;
  color: #9db5a8;
  margin: 8rpx 0;
  /* 与下方居中的表情格子对齐（原来靠左，格子一居中就成了孤立标签） */
  text-align: center;
}

.emote-group.good {
  color: #43c07c;
}

.emote-group.bad {
  color: #e07a6a;
}

.emote-cells {
  display: flex;
  gap: 8rpx;
  flex-wrap: wrap;
  /*
   * 2026-10-23 居中（用户报「互动中的显示出现异常」）：格子是可变宽度的胶囊，
   * 每行能排几个取决于文案长度 —— 原来默认 flex-start，7 个表情排成 6+1，
   * 第二行单个「比心」顶在最左、右侧空出半张卡片，看起来像排版错位。
   * 每行居中后：首行居中、末行单个也居中，视觉上是一个居中的整体。
   */
  justify-content: center;
}

/*
 * 胶囊本体（2026-10-23 「中间的图标没有居中」）。
 *
 * 坑：app.wxss 的 `button { display: inline-block !important }` 会压掉普通
 * `display: flex`，于是图标与文案退化成行内流、按 **baseline** 对齐 ——
 * 16px 的 emoji 顶得比 10px 的文案高半行，视觉上就是「图标没居中」。
 *
 * 修法：用**同样带 !important 的类选择器**（类优先级 > 元素）把它改成
 * inline-flex，再 `align-items: center` + `justify-content: center` 真正居中；
 * 图标与文案之间用 `gap` 固定间距，不再依赖 emoji 字形的自带边距。
 */
.emote-cell {
  display: inline-flex !important;
  align-items: center;
  justify-content: center;
  flex-direction: row;
  gap: 5rpx;
  height: 88rpx;
  font-size: 20rpx;
  padding: 0 14rpx;
  line-height: 1.2;
}

.emote-cell .ico {
  font-size: 32rpx;
}

/*
 * 兜底（2026-10-23）：万一某些基础库版本的 `<button>` 不吃 display 覆盖，
 * 归位后仍是行内流 —— 那就让两个 text 都用 vertical-align: middle 对齐中线，
 * 避免 16px 的 emoji 按 baseline 顶高。flex 生效时这条被忽略，无副作用。
 */
.emote-cell text {
  vertical-align: middle;
}

.settle-card {
  width: 94%;
  max-width: 1200rpx;
}

.settle-body {
  max-height: 52vh;
}

.settle-note {
  font-size: 22rpx;
  color: #b9cfc2;
  padding: 6rpx 0;
}

.settle-totals {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #f6e3a1;
}

/*
 * 矮视口（手机横屏）：px 定尺 —— rpx 随屏宽放大，宽而矮的窗口里会把 HUD/手牌条
 * 一起撑爆、把画布挤没。这里把非画布 chrome 压到最小；手牌与提示都已改为盖在
 * 画布下方流内排布，与画布同属一屏（见 §10.8⑦）。
 */
@media (max-height: 680px) {
  .game {
    padding-top: calc(3px + max(var(--safe-t, 0px), env(safe-area-inset-top, 0px)));
    padding-right: calc(8px + max(var(--safe-r, 0px), env(safe-area-inset-right, 0px)));
    padding-bottom: calc(3px + env(safe-area-inset-bottom, 0px));
    padding-left: calc(8px + max(var(--safe-l, 0px), env(safe-area-inset-left, 0px)));
  }

  .banner {
    margin-bottom: 4px;
    padding: 4px 10px;
    font-size: 11px;
  }

  /* 自绘顶栏紧凑档：24px 高（竖档 28px），信息字号压到 10/11px */
  .g-top {
    height: 24px;
    gap: 6px;
    margin-bottom: 1px;
  }

  .g-top-back {
    width: 22px;
    height: 22px;
    line-height: 20px;
    font-size: 15px;
  }

  .g-top-info {
    gap: 6px;
  }

  .g-top-item,
  .g-top .code {
    font-size: 10px;
  }

  .g-top .badge {
    font-size: 9px;
    padding: 0 6px;
  }

  .g-top-cap {
    width: 104px;
  }

  /* 侧边轨紧凑档：32px 直径，间距 6px */
  .rail {
    gap: 6px;
  }

  .rail-btn {
    width: 32px !important;
    height: 32px;
    line-height: 30px;
    font-size: 15px;
  }

  .rail-badge {
    min-width: 14px;
    height: 14px;
    line-height: 14px;
    font-size: 9px;
  }

  /* 弹层面板紧凑档：贴边距更小、消息/记录字号 10px */
  .panel-card {
    width: min(86vw, 560px);
    border-radius: 10px;
  }

  .chat-card {
    width: min(78vw, 480px);
  }

  .panel-head {
    padding: 4px 8px;
  }

  .panel-title {
    font-size: 12px;
  }

  .panel-x {
    width: 22px !important;
    height: 22px;
    line-height: 20px;
    font-size: 11px;
  }

  .panel-body {
    padding: 3px 8px;
  }

  .chat-log,
  .log-list {
    max-height: none;
    padding: 4px 8px;
  }

  .chat-msg {
    font-size: 11px;
  }

  .log-row {
    font-size: 10px;
    padding: 1px 0;
  }

  .log-seat {
    min-width: 56px;
  }

  .chat-pop {
    max-height: 30vh;
  }

  .chat-pop-row {
    gap: 6px;
    padding: 5px 8px;
  }

  .chat-chip {
    height: 26px;
    line-height: 24px;
    font-size: 11px;
    padding: 0 8px;
  }

  .chat-input-row {
    padding: 4px 6px;
    gap: 4px;
  }

  .chat-ico {
    width: 28px !important;
    height: 28px;
    line-height: 26px;
    font-size: 13px;
  }

  .chat-input {
    height: 28px;
    font-size: 11px;
    padding: 0 8px;
  }

  .chat-send {
    height: 28px;
    line-height: 26px;
    font-size: 11px;
    padding: 0 10px;
  }

  /* 浮层按钮行：app.wxss 的 .btn-row button 是 72rpx 竖档，矮宽窗口里 rpx 被放大
     →「关闭」这类单钮会被撑成巨型按钮（2026-10-17 用户报「开关异常」）。这里压回 px 档。 */
  .btn-row {
    margin-top: 2px;
  }

  .btn-row button {
    height: 30px;
    line-height: 28px;
    padding: 0 12px;
    font-size: 12px;
  }

  /* ---- 画布下方操作区 ---- */
  /* 状态行恒占 15px（左文案 + 右倒计时），控件出现/消失不改变总高 → 画布不跳 */
  .g-status {
    height: 15px;
    line-height: 15px;
    margin: 1px 0;
  }
  .g-status-text {
    font-size: 12px;
  }

  .g-status-text.err {
    font-size: 11px;
  }

  /* 结算态状态行（手牌带已退场）：一行结果 + 右侧「本局结算 ▲」 */
  .g-status.over {
    height: 22px;
    line-height: 22px;
  }

  .g-status.over .g-status-text {
    font-size: 12px;
  }

  .g-status.over .settle-restore {
    height: 18px;
    line-height: 18px;
    font-size: 11px;
  }

  .countdown {
    margin-left: 5px;
    padding: 0 5px;
    font-size: 11px;
    line-height: 14px;
  }

  .waits-chip {
    margin-left: 5px;
    padding: 0 6px;
    font-size: 11px;
    line-height: 14px;
  }

  .controls button {
    height: 30px;
    line-height: 28px;
    font-size: 12px;
    padding: 0 12px;
    margin: 0 3px;
  }

  .settle-restore {
    margin-left: 6px;
    padding: 0 8px;
    height: 14px;
    line-height: 14px;
    font-size: 10px;
  }

  .hand-tray .tray-row {
    padding: 1px 0;
  }

  .tray-stack {
    min-height: 68px;
  }

  /*
   * 2026-10-21：`.tile-btn / .tile-rank / .tile-suit / .tile-honor` 的四条
   * 覆盖已经删掉 —— 牌位与字号现在是**全档统一的 px 定尺**（46×66 / 25/12/27，
   * 见文件上方「手牌牌位」注释）。这里再写一遍只会制造第二个真相，
   * 日后改一处忘了另一处就会重演「rpx 尺寸配 px 字号」的裁切事故。
   */

  /* 浮层 */
  .layer-card {
    width: 88%;
    padding: 14px 16px;
  }

  .layer-title {
    font-size: 15px;
    margin-bottom: 8px;
  }

  .layer-text {
    font-size: 12px;
    margin-bottom: 12px;
  }

  .tbl-row {
    font-size: 12px;
  }

  .tbl-cell {
    padding: 3px 4px;
  }

  /* 报杠行紧凑档：28px 行高 / 24px 胶囊（行高固定，只有整行显隐会变，由 chromeKey 触发重量） */
  .declare-row {
    height: 28px;
    margin-bottom: 3px;
    gap: 5px;
  }

  .declare-btn {
    height: 24px;
    padding: 0 10px;
    font-size: 11px;
  }

  .emote-card {
    width: 70vw;
    max-width: 480px;
  }

  .emote-target {
    height: 28px;
    line-height: 26px;
    font-size: 11px;
    padding: 0 10px;
  }

  .emote-grid {
    max-height: 36vh;
  }

  .emote-group {
    font-size: 11px;
    margin: 4px 0;
  }

  .emote-cell {
    height: 44px;
    font-size: 10px;
    padding: 0 8px;
  }

  .emote-cell .ico {
    font-size: 18px;
  }

  .settle-card {
    width: 96%;
  }

  .settle-body {
    max-height: 56vh;
  }

  .settle-note {
    font-size: 11px;
    padding: 3px 0;
  }

  .settle-totals {
    font-size: 12px;
    margin-top: 6px;
  }

  .toast {
    font-size: 12px;
    padding: 6px 12px;
    /* 提示浮层改到手牌条（出牌器）**上方**：fixed 的 bottom 要跨过整个操作区
       （状态行 15px + 间距 2px + 手牌条 68px + 页脚 padding 4px + 6px 间隙），
       并叠上 iPhone 底部安全区。盖住的是牌桌下沿的牌河（提示 3s 自动消失）。 */
    bottom: calc(95px + env(safe-area-inset-bottom, 0px));
  }
}

/*
 * 窄横屏（≤700 CSS px）：**手牌相关的一条都不写**。
 * 这里曾经放着一份 39×55 / 21·10·23 的缩小档，断点按**窗口宽**判断；而手牌条宽度
 * 绑 canvasW（2:1 反算），844px 的横屏手机命中不了 700px 档、牌却照样放不下 ——
 * 两个真相互相补不齐（用户报「手牌为啥还能滑动」）。
 * 2026-10-21 起牌位/字号由 handMetrics 按实测条宽统一下发（CSS 变量），所有宽度
 * 一份真相；此档只保留与手牌无关的控件尺寸。
 */
@media (max-width: 700px) {
  .controls button {
    height: 28px;
    line-height: 26px;
    font-size: 12px;
    padding: 0 10px;
    margin: 0 2px;
  }
}