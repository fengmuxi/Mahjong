.game {
  /* 横向 padding 吃进刘海 / 挖孔内缩。两个来源取大者（max）：
     ① var(--safe-l/r)：computeSafeInsets 用「探测元素」量出的 env() 真实值 +
        wx.getWindowInfo().safeArea（部分安卓机型横屏只认这个）；
     ② env(safe-area-inset-left/right)：iOS 横屏的可靠来源。
     无刘海 / 挖孔设备两者都是 0px，布局与原样一致。
     **顶部同理**（--safe-t）：navigationStyle=custom 后页面铺满全屏，自绘顶栏
     必须自己避开系统状态栏（安卓横屏 ~24px，iOS 横屏 0）。底部安全区仍走 env()。 */
  padding-top: calc(4px + max(var(--safe-t, 0px), env(safe-area-inset-top, 0px)));
  padding-right: calc(16rpx + max(var(--safe-r, 0px), env(safe-area-inset-right, 0px)));
  padding-bottom: calc(12rpx + env(safe-area-inset-bottom, 0px));
  padding-left: calc(16rpx + max(var(--safe-l, 0px), env(safe-area-inset-left, 0px)));
  height: 100vh;
  display: flex;
  flex-direction: column;
  /* 浮层的定位基准：.layer 在 game 页改为 absolute（见下），必须有个 relative 祖先 */
  position: relative;
}

/*
 * 浮层定位（2026-10-17 修）：
 * app.wxss 的 .layer 是 position:fixed + inset:0 弹性居中，基准是小程序**文档**而非
 * 可视区 —— 本页 .game 高 100vh（含导航栏区），文档比可视区高出一截，fixed 卡片
 * 实测比屏心低 ~23 CSS px、左 ~34 CSS px（横向偏移疑与页面溢出/滚动有关）。
 * 改为 absolute + inset:0：基准变成 .game 的 padding box（上面已加 position:relative），
 * 即本页整个可视流区，卡片随之精确居中；导航栏是原生 UI 在流区之外，本就无需 Dim。
 * 注意只覆盖 game 页：lobby 页仍用 app.wxss 的 fixed 版。
 */
.game .layer {
  position: absolute;
}

/* ---------- 整屏桌面（2026-10-22） ---------- */
/*
 * 用户参考图（源项目 liumengniu/majiang 的对局画面）里，绿绒龙纹桌是**铺满整屏**的，
 * 手牌直接坐在桌上；而本页原来的桌面是 canvas 里的一张贴图 —— 画布 2:1 又被行高
 * 卡成手机横屏宽度的 ~65%，左右两条深色空白里飘着按钮轨，观感像「一张牌桌摆在黑屋子里」。
 *
 * 现在：这一层 DOM 铺整页（`<image mode="scaleToFill">`），canvas 里画同一张图的同一块
 * （table.js 的 drawTable 按 `frame` 矩形铺），两层映射完全一致 → 画布矩形内由 canvas 画、
 * 矩形外由 DOM 画，接缝不可见。**两边都必须是「非等比整铺」**：
 * 换成 cover/等比会裁边，2:1 的图铺 2.16:1 的横屏会把上下木框各裁掉一截，只剩左右两条竖框。
 * canvas 那边同样按整铺算，不要改成 cover。
 *
 * 为什么不能干脆把 canvas 拉满整屏：<canvas type="2d"> 是原生组件，会压住其矩形内的
 * 所有 DOM（手牌条、按钮轨都会看不见点不着），所以 canvas 只能占中间那块，
 * 桌面靠「DOM 铺外圈 + canvas 铺内圈」拼出来。
 */
.felt {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 0;
  pointer-events: none;
  /* 兜底色 = 桌面贴图绒布的平均色（采样 table.webp：#116347~#186f4f 之间）——
     图片还在路上时铺的就是它，不会先闪一块黑。 */
  background-color: #14614a;
  /* <image mode="scaleToFill"> 铺满（非等比拉伸，与 canvas 侧 drawImage 的整铺映射一致） */
  display: block;
  width: 100%;
  height: 100%;
}

/* UI 整通道拿不到（清单空 / 请求失败）：退成矢量桌的外层藏青，见 game.js 的 loadUiArt */
.felt.na {
  background-color: #0d1626;
}

/* 桌面之上的所有内容都要显式抬一层，否则会被 .felt 盖住（同为普通 DOM，按 z-index 排） */
.g-top,
.banner,
.game-main,
.board-overlay {
  position: relative;
  z-index: 1;
}

/* ---------- 自绘顶栏（navigationStyle=custom） ---------- */
/*
 * 2026-10-21 布局重排（用户报「牌面区域小、功能都挤在顶部」）。
 * 改前：原生导航栏（44px）+ HUD 一行（玩法/房间/牌墙/精 + 4 枚功能钮）≈ 74px 高度，
 * 牌桌一寸都沾不到。改后：合成一行 28px 的极简信息条，功能钮全部迁到左右侧边轨
 * （.rail），牌桌高度净赚 ~44px、宽度净赚两条侧栏（PC 宽窗约 400px）。
 * 高度与 game.js 的 TOPBAR_H 必须一致（estimateWrap 的兜底估算要用）。
 */
.g-top {
  display: flex;
  align-items: center;
  gap: 10rpx;
  height: 28px;
  margin-bottom: 2px;
  flex-shrink: 0;
  min-width: 0;
}

.g-top-back {
  width: 26px;
  height: 26px;
  line-height: 24px;
  text-align: center;
  font-size: 18px;
  color: #f6e3a1;
  border: 1px solid rgba(255, 255, 255, 0.18);
  border-radius: 8rpx;
  background: rgba(16, 26, 21, 0.7);
  flex-shrink: 0;
}

.g-top-info {
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-width: 0;
  flex: 1;
  overflow: hidden;
  white-space: nowrap;
}

/* 右侧避让系统胶囊（⋯ ○）：CAPSULE_W 与 game.js 常量一致 */
.g-top-cap {
  width: 118px;
  flex-shrink: 0;
}

.g-top-item {
  font-size: 11px;
  color: #b9cfc2;
  min-width: 0;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* jingText 很长（赣州：「正精 北 · 副精 东（其余 10 张结算揭晓）」）→ 单独一色 + 省略号 */
.g-top-item.jing {
  color: #e0a86a;
}

.g-top .badge {
  font-size: 10px;
  padding: 1px 8px;
  flex-shrink: 0;
}

.g-top .code {
  font-size: 11px;
  flex-shrink: 0;
}

/* ---------- 侧边按钮轨（rail） ---------- */
/*
 * 左右各一列 36px 的浮层按钮，absolute 贴在 .game-main 两缘。
 * **绝不占流宽、也绝不压画布**：fitCanvas 的 min(行宽 − 84, 行高×2) 保证画布两侧
 * 各留 ≥ 42px 空白；原生 canvas 合成层级高于 DOM，压在画布上的钮会被盖住点不到
 * （2026-10-17 实测 cover-view 都盖不住 canvas，详见 §10.8⑦）。
 * 手机横屏画布被行高卡住（宽有富余）→ 轨落在纯空白区；宽窗口画布吃宽度 → 让出的
 * 84px 正好归轨。骰子阶段整轨隐藏（diceShown，覆盖层已盖满全页）。
 *
 * 2026-10-25（用户报「对局中时右侧的菜单栏会和顶部的小程序 ui 重叠」）：
 * **不再用 `top:50% + translateY(-50%)` 在整块 game-main 里垂直居中。**
 * 原因：`navigationStyle=custom` 下微信胶囊（⋯ ○）由微信自己绘制，位置随状态栏走，
 * 会**伸进 .game-main 顶部**；而手机横屏的 game-main 只有 215~230px 高，
 * 6 个钮的轨却要 222px —— 居中后轨顶必然被顶进胶囊（iPhone 13 实测重叠 18px、
 * SE 重叠 25.5px，`scripts/verify/railtop.cjs` 量的）。
 * 现在改成：
 *   · `top` 由 JS（syncRailTop）按**胶囊实测下沿 + 6px** 下发 —— 设备无关；
 *   · `bottom: 2px`，于是这一列的高度 = 「胶囊下沿 .. 手牌区上沿」这段安全带；
 *   · 按钮包在 .rail-inner 里，`margin: auto 0` 在带内居中；**带子装不下时
 *     margin 自动归零**，配合 overflow-y:auto 从顶部可滚 —— 绝不溢出到胶囊或手牌上。
 * （`.rail-inner` 的 margin-auto 居中比 `justify-content:center` 好在：后者在
 *  overflow 时会把内容顶部推到不可滚区域，是 flex 的经典坑。）
 */
.rail {
  position: absolute;
  /* 兜底 16px；真实值由 WXML 的 inline style（railTop）覆盖 */
  top: 16px;
  bottom: 2px;
  display: flex;
  flex-direction: column;
  overflow-x: hidden;
  overflow-y: auto;
  z-index: 5;
  /*
   * padding 是给 `.rail-badge` 留的：未读红点是 `top:-2px; right:-2px` 的**外凸**，
   * 而 overflow 会在 padding box 处裁切 —— 不留余量就会把红点切掉一条。
   * 3px 横向 + 2px 纵向足够包住 2px 的外凸；两条轨用 left/right:-1px 抵消，
   * 按钮的视觉位置仍是距边 2px（-1 + 3 = 2）。
   */
  padding: 2px 3px;
  /* 微信里 overlay 滚动条本来就不占位，这里只是给 Chromium 探针用 */
  scrollbar-width: none;
}

.rail::-webkit-scrollbar {
  display: none;
}

.rail-inner {
  display: flex;
  flex-direction: column;
  gap: 8px;
  /* 有余量 → 垂直居中；装不下 → auto 归零，从顶部可滚 */
  margin: auto 0;
}

.rail-l {
  left: -1px;
}

.rail-r {
  right: -1px;
}

.rail-btn {
  width: 36px !important;
  height: 36px;
  line-height: 34px;
  padding: 0;
  text-align: center;
  font-size: 17px;
  border-radius: 999px;
  color: #e8e2cf;
  background: rgba(16, 26, 21, 0.82);
  border: 1px solid rgba(255, 255, 255, 0.16);
  position: relative;
  flex-shrink: 0;
}

/* 面板打开态 / 托管激活态：金底（与参考图右列同款） */
.rail-btn.on {
  background: rgba(230, 193, 75, 0.22);
  border-color: rgba(230, 193, 75, 0.85);
  color: #f6e3a1;
}

.rail-btn.danger {
  color: #e07a6a;
  border-color: rgba(224, 122, 106, 0.5);
}

/* 局内「退出」钮：两字需缩小字号才能落进 36px 圆钮 */
.rail-btn.exit {
  font-size: 12px;
  letter-spacing: 0;
  color: #f0c674;
  border-color: rgba(240, 198, 116, 0.55);
}

/* 未读红点：贴在聊天钮右上角 */
.rail-badge {
  position: absolute;
  top: -2px;
  right: -2px;
  min-width: 16px;
  height: 16px;
  line-height: 16px;
  padding: 0 3px;
  border-radius: 999px;
  background: #e5484d;
  color: #fff;
  font-size: 10px;
  font-weight: 700;
}

/* ---------- 记录 / 聊天弹层面板 ---------- */
/*
 * 面板是 .game-main 的**子元素**（absolute inset:0）而不是 .game 的：
 * .game-main 正好就是「牌桌区」，面板盖上去不遮底部手牌条 —— 看记录/聊天时
 * 牌局还在走，手牌必须留着能出。配合 panelOpen 把 canvas 切 display:none
 * （原生组件合成层级在 DOM 之上，不藏面板会被牌桌盖住），与 .on-modal 同机制。
 */
.side-panel {
  position: absolute;
  inset: 0;
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: center;
  /* 2026-10-24：留出一圈给 Dim 露边。卡片改成 height:100%（见下）之后，
     没有 padding 会把整块 Dim 完全挡住，看着不像弹层而像换了个页面。 */
  padding: 8rpx;
  background: rgba(6, 10, 16, 0.55);
  border-radius: 12rpx;
}

.panel-card {
  width: min(72vw, 560px);
  /*
   * 2026-10-24（用户报「操作记录和聊天信息无法滚动显示」）：
   * 这里原来只有 `max-height: 100%` —— 一条**不确定高度链**：
   * .side-panel(absolute inset:0) → .panel-card(max-height:%) → .panel-body(flex:1)。
   * Chromium 能把百分比 max-height 反推出确定高（脚本 scripts/verify/panelscroll_before.cjs
   * 量过：旧写法在 Chromium 里照样溢出的），**微信渲染器推不出来**，
   * 于是 flex:1 的 scroll-view 退化成「内容多高就多高」→ 永不溢出、划不动，
   * 卡片自身的 overflow:hidden 再把多出来的部分切掉 → 下面的记录/消息永远看不到。
   * ⚠ 本地无法复现微信那一侧，所以这条是**推断**而非实测；但改成 `height: 100%`
   * 之后整条链与百分比彻底无关、高度由构造确定，是严格更强的写法，且与本仓库
   * 既有约定一致：所有**能滚**的竖向 scroll-view（.settle-body 52vh / .emote-grid 320rpx /
   * .chat-pop 200rpx）都是把高度直接写在 scroll-view 自己身上，没有一个是靠 flex 推的。
   */
  height: 100%;
  max-height: 100%;
  display: flex;
  flex-direction: column;
  background: rgba(16, 26, 21, 0.97);
  border: 2rpx solid rgba(255, 255, 255, 0.16);
  border-radius: 14rpx;
  overflow: hidden;
  box-shadow: 0 10px 28px rgba(0, 0, 0, 0.45);
}

.chat-card {
  width: min(64vw, 480px);
}

.panel-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  padding: 6px 10px;
  border-bottom: 2rpx solid rgba(255, 255, 255, 0.08);
  flex-shrink: 0;
}

.panel-title {
  font-size: 13px;
  color: #f6e3a1;
  font-weight: 700;
}

.panel-x {
  width: 26px !important;
  height: 26px;
  line-height: 24px;
  padding: 0;
  text-align: center;
  font-size: 13px;
  color: #9db5a8;
  background: transparent;
}

.panel-body {
  flex: 1;
  min-height: 0;
  padding: 6px 10px;
}

/* ---------- 牌桌行 ---------- */
/*
 * 2026-10-21：三栏（记录 | 画布 | 聊天）废除，画布独占整行；记录/聊天改成左右
 * 侧边钮 + 弹层面板（见上方 .rail / .side-panel），所以这里**不再有 gap**，
 * 也不需要再和 JS 常量对齐侧栏宽。position:relative 是 .rail/.side-panel 的定位基准。
 */
.game-main {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: row;
  position: relative;
}

/*
 * 画布贴操作区底边（2026-10-20 出血对齐）：画布在「行宽 < 行高×2」时高度吃不满
 * wrap（宽约束），原来垂直居中会上下都留 felt 空隙、与手牌条隔着一条缝；
 * 改 flex-end 让牌桌坐在手牌条正上方（无垂直余量时与原来完全一致 —— 手机横屏
 * 常态就是这种：canvasH = 行高，改动零表现）。
 */
.canvas-wrap {
  flex: 1;
  min-width: 0;
  min-height: 0;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  position: relative;
}

/*
 * 画布自身不再带 border-radius（2026-10-22）：桌面现在是**整屏**的（见 .felt），
 * 画布只是桌面中间的一扇窗，给画布倒角等于在绿绒桌中间抠出一个圆角矩形，
 * 而且画布四角露出的是 DOM 底色，与 canvas 里同图不同源，会有一圈色差。
 * display:block 不能省 —— canvas 是行内元素，行内会有基线空隙、画布高度被撑大。
 */
.canvas-wrap canvas {
  display: block;
}

/*
 * 浮层打开期间藏掉牌桌画布（JS 侧 modalOpen → on-modal）。
 * 原因：<canvas type="2d"> 是原生组件，合成层级在 DOM 之上 —— fixed 的 .layer
 * Dim 不到它、盖不住它，且浮层打开时牌桌仍会被穿透点击（能点牌出牌）。
 * 用 class 切 display 而非 wx:if：后者会销毁 canvas 节点，this.table 实例
 * 与已绘牌面一起失效。关闭时 syncModal 里会补 render + fitCanvas。
 */
.canvas-wrap canvas.on-modal {
  display: none;
}

/*
 * 底部操作区：提示 → 吃碰杠胡 → 手牌，在画布下方**流内**排布。
 * （曾试图用 cover-view 盖在牌桌下缘，2026-10-17 实测否决：开发者工具里 cover-view
 *  同样盖不住原生 canvas —— 实时 DOM 里整块操作区都渲染了却完全不可见。详见 §10.8⑦。）
 * **不要在这里再写 padding-bottom: env(safe-area-inset-bottom)** —— `.game` 的底部内边距
 * 已经算过一份，再加一份会让底部多空出 ~21px（横屏 home indicator），那段高度本该归画布。
 */
.board-overlay {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex-shrink: 0;
}

/*
 * 刘海/挖孔探测元素（computeSafeInsets 用）：宽/高直接写成 env(safe-area-inset-left/right/top)，
 * SelectorQuery 量它的宽/高 = 当前运行时里 env() 的真实解析值。0 尺寸 + absolute + 不可见，
 * 不占布局、不挡点击。`#safe-probe-l/r` 写 width（横向量），`#safe-probe-t` 写 height（顶部量）。
 */
.safe-probe {
  position: absolute;
  left: 0;
  top: 0;
  height: 0;
  visibility: hidden;
  pointer-events: none;
}

#safe-probe-l {
  width: env(safe-area-inset-left, 0px);
}

#safe-probe-r {
  width: env(safe-area-inset-right, 0px);
}

#safe-probe-t {
  width: 0;
  height: env(safe-area-inset-top, 0px);
}

/*
 * 提示浮层（事件/错误 toast）在局内改到手牌条（出牌器）**上方**——
 * app.wxss 的 `.toast` 是 fixed bottom:40rpx，正好压在手牌条上（用户截图红框）。
 * fixed 相对视口定位，bottom 要跨过整个操作区：状态行 32rpx + 间距 4rpx
 * + 手牌条 96rpx + 页脚 padding 12rpx + 间隙 12rpx ≈ 156rpx。
 * 浮层盖住的是牌桌下沿的牌河（提示 3s 自动消失，不常驻）。
 * 手机横屏紧凑档的 px 精确定位在下方 media 块里。
 */
.toast {
  bottom: 156rpx;
}

/* ---------- 局内聊天（只在侧边弹层面板里出现，2026-10-21） ---------- */
/*
 * 聊天从「流内右列 / HUD 圆钮展开」并入侧边轨 💬 弹窗（.panel-card.chat-card）。
 * 这里只留面板内部用的样式：消息区 + 快捷语/表情 + 输入行。
 */
.chat {
  min-width: 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/*
 * 消息区高度：`flex: 1` 占满卡片剩余空间（卡片已定高，见 .panel-card）。
 * ⚠ 不要再加 `max-height: 300rpx` 这类小帽子 —— 那是「流内右列」时代的遗物，
 * 弹层面板里它会把消息区压到 156px，卡片下半全空着。
 */
.chat-log,
.log-list {
  flex: 1;
  min-height: 0;
  padding: 8rpx 12rpx;
}

.chat-msg {
  font-size: 22rpx;
  line-height: 1.6;
  word-break: break-all;
}

.chat-msg.self .chat-name {
  color: #f6e3a1;
}

.chat-name {
  color: #9db5a8;
}

.log-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 20rpx;
  padding: 3rpx 0;
}

.log-seat {
  color: #9db5a8;
  min-width: 96rpx;
}

.log-action {
  padding: 0 10rpx;
  border-radius: 6rpx;
  background: rgba(255, 255, 255, 0.08);
}

.log-action.hu {
  background: rgba(229, 72, 77, 0.25);
  color: #ef9a9a;
}

.log-action.gang,
.log-action.angang,
.log-action.bugang {
  background: rgba(255, 152, 0, 0.22);
  color: #ffb74d;
}

.log-action.peng {
  background: rgba(33, 150, 243, 0.22);
  color: #64b5f6;
}

.log-action.chi {
  background: rgba(76, 175, 80, 0.22);
  color: #81c784;
}

/* 快捷语 / 表情：scroll-view 才能真正滚动（普通 view 的 overflow 不生效） */
.chat-pop {
  max-height: 200rpx;
  /* 卡片改定高后，这两行属于「不被 flex 压缩」的部分：压扁了就没法看/没法点 */
  flex-shrink: 0;
}

.chat-pop-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  padding: 8rpx 12rpx;
}

.chat-chip {
  height: 52rpx;
  line-height: 48rpx;
  font-size: 22rpx;
  padding: 0 14rpx;
}

.chat-input-row {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 8rpx 10rpx;
  border-top: 2rpx solid rgba(255, 255, 255, 0.08);
  /* 同 .chat-pop：输入行被 flex 压扁就没法看/没法点了 */
  flex-shrink: 0;
}

.chat-ico {
  /* !important 同上：破内置 184px 定宽 */
  width: 52rpx !important;
  height: 52rpx;
  line-height: 48rpx;
  padding: 0;
  text-align: center;
  font-size: 24rpx;
}

.chat-input {
  flex: 1;
  /* input 默认有 ~150px 的固有宽度，不给 min-width:0 会把「发送」挤出侧栏 */
  min-width: 0;
  height: 52rpx;
  padding: 0 12rpx;
  border-radius: 8rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.14);
  background: rgba(0, 0, 0, 0.25);
  color: #e8efe9;
  font-size: 22rpx;
}

.chat-send {
  height: 52rpx;
  line-height: 48rpx;
  font-size: 22rpx;
  padding: 0 16rpx;
}

/* ---------- 画布下方的操作区（提示 / 控件 / 手牌） ---------- */
/*
 * 状态行恒占一行：左文案 + 右倒计时。**不要用 wx:if 增删这一行** ——
 * 一增一删会让操作区总高变化，画布随之重排跳动（用户报「报杠提示把牌桌往上顶」）。
 * 高度锁死 + 文案省略号，保证任何状态下总高都不变。
 */
.g-status {
  width: 100%;
  height: 32rpx;
  line-height: 32rpx;
  margin: 2rpx 0;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.g-status-text {
  font-size: 24rpx;
  color: #e8efe9;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  flex-shrink: 1;
  min-width: 0;
}

/*
 * 结算态的状态行：手牌带退场后这块就是操作区的全部内容，可以放宽一点
 * 让胡牌结果和「本局结算 ▲」都看得清。高度变化发生在「进入/离开结算」这一帧，
 * JS 侧 chromeKey 翻转会补一次 fitCanvas()，画布跟着重排，不会留下空隙。
 */
.g-status.over {
  height: 44rpx;
  line-height: 44rpx;
}

.g-status.over .g-status-text {
  font-size: 26rpx;
  color: #f6e3a1;
}

/* 听牌提示（2026-10-23）：与倒计时同款小胶囊，挂在状态行右侧。
   内容由服务端 view.waits 决定（能自摸胡的进张），前端不判规则。
   高度必须 ≤ 状态行高度（常态 32rpx / 紧凑档 15px），否则会被 overflow:hidden 裁掉。 */
.waits-chip {
  margin-left: 10rpx;
  padding: 0 12rpx;
  border-radius: 999rpx;
  background: rgba(230, 193, 75, 0.18);
  border: 1px solid rgba(230, 193, 75, 0.7);
  color: #f6e3a1;
  font-size: 22rpx;
  line-height: 30rpx;
  white-space: nowrap;
  flex-shrink: 0;
}

/* 响应倒计时：并进状态行（原先绝对定位在画布顶部，会被原生 canvas 盖住） */
.countdown {
  margin-left: 10rpx;
  padding: 0 10rpx;
  border-radius: 999rpx;
  background: rgba(0, 0, 0, 0.45);
  color: #f6e3a1;
  font-size: 22rpx;
  line-height: 30rpx;
  white-space: nowrap;
  flex-shrink: 0;
}

/* 错误提示：占位替换状态文案（同一行），不再单独占一行 —— 否则一出现就把
   操作区顶高、画布重排（线上旧服务端每 10s 回一次「未知消息」时最明显）。 */
.g-status-text.err {
  color: #e07a6a;
}

.controls {
  display: flex;
  /*
   * 2026-10-24：操作带改成**恒高的固定格子**（.action-bar，现 34px）后，这里仍是它的唯一
   * 子节点、且是 flex item —— 不给死宽度会被压到 min-content（≈一个钮宽），整排竖着叠。
   * `width:100%` 之后按钮才在行宽内排布。
   * ⚠ `flex-wrap:nowrap` 是**硬约束**：这一带高度锁死（34px），一旦折行，多出来的一行
   * 会被 .claim-row 的 align-items:flex-end 推向**上方**—— 那里是原生 canvas，
   * 按钮直接看不见（§10.7：canvas 合成层永远在 DOM 之上）。宁可让钮横向压缩，
   * 也绝不能折行。压缩由下方 .ctrl 的 flex-shrink + 图片 max-width:100% 完成。
   */
  flex-wrap: nowrap;
  justify-content: center;
  /*
   * 底对齐：报杠胶囊只有 25px、艺术钮 33px，默认 `stretch` 会让两者的**顶边**齐平
   * （胶囊看着像浮在艺术钮上方）。统一贴底，视觉上才是「同一排按钮」。
   */
  align-items: flex-end;
  width: 100%;
}

/*
 * 操作钮艺术图变体（2026-10-21 起，2026-10-23 补齐吃/暗杠/自摸/展示）：
 * 吃/碰/杠/胡/过 全走 CDN 位图（utils/uiart.js），图上再压一行小注（牌名/牌型）。
 * 设计约束：
 *   · 总高 ≈ 图高（小注用负边距压回图下缘）—— 2026-10-24 起按钮搬进 .action-bar
 *     （恒高格子，见下方 .action-bar；2026-10-25 由 44px 收到 34px）；
 *     格子高度锁死，所以这一行**绝不能折行**（.controls 是 nowrap），
 *     窄条时靠 flex-shrink 横向压缩。
 *   · display/margin 要压 app.wxss 的全局 `button{}` !important 四条；
 *   · 清单未就绪时类里没有 .art，整块退回上面的文字钮。
 */
.ctrl.art {
  display: block !important;
  height: auto;
  line-height: 1;
  padding: 0;
  border: 0;
  background: transparent;
  /* 纵向不留边距：这 1px 让给「按钮与手牌之间的缝」（见 .claim-row 的 bottom:1px） */
  margin: 0 4px !important;
  /* 窄条时参与横向压缩（配合 .ctrl-img 的 max-width:100%） */
  flex-shrink: 1;
  min-width: 0;
  overflow: hidden;
}
/*
 * 2026-10-23 用户报「操作按钮显示太大、底部信息显示不全」：图标原来用 rpx
 * （92×78rpx），在宽而矮的横屏窗口里 1rpx 被放大到 1.3~2.5px，图标长到
 * 100~235px，远超 66px 的手牌和 68px 的遮罩，caption 被顶出屏幕。
 * 改为 px 定尺（375px 宽基准），再用 max-* 挂回 rpx —— 窄屏仍按比例缩，
 * 宽屏不再放大。宽高上限同比例（2rpx:1px），不会拉变形。
 */
.ctrl.art .ctrl-img {
  display: block;
  width: 34px;
  max-width: 68rpx;
  height: 29px;
  max-height: 58rpx;
  margin: 0 auto;
}
.ctrl.art .ctrl-cap {
  display: block;
  margin: -5px auto 0;
  padding: 0 4px;
  max-width: 46px;
  border-radius: 999rpx;
  background: rgba(8, 12, 18, 0.72);
  color: #f2e6c8;
  font-size: 8px;
  line-height: 9px;
  text-align: center;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/*
 * 同屏 ≥7 个钮时的**全体小号**（2026-10-23）：7 个钮（吃 3 组 + 碰/杠/胡 + 过）按
 * 46px 排一行要 7×(46+8) = 378px > 375px 基准，一行放不下。
 * **必须全体一起缩** —— 只缩吃钮会让同屏图标大小不一（用户报「有的显示
 * 更大有的更小」）。38px 时 7×(38+8) = 322px < 375px，一行放得下。
 * ⚠ 2026-10-24 第五十轮起这一条更要守住：操作带高度锁死、.controls 是 nowrap，
 * 一旦排不下就只能靠 flex-shrink 横向压缩（图标被挤窄），所以 compact 是
 * 「保持图标大小一致」与「不被挤扁」之间的唯一手段。阈值按**总钮数**算
 * （吃碰杠胡 + 报杠，见 applyControls），否则「4 报杠 + 3 暗杠」这种 7 钮会漏缩。
 */
/*
 * 图片跟着按钮横向压缩（.controls 是 nowrap，窄条时靠 flex-shrink 分配）。
 * 这条必须写在 `.ctrl.art .ctrl-img` 那条尺寸规则之后：同特异度 (0,2,0)，后来者胜，
 * 把 rpx 上限换成「不超过按钮自己的盒子」，窄条时才压得下去（而不是被 overflow 切掉）。
 */
.ctrl.art .ctrl-img {
  max-width: 100%;
}

/*
 * 同屏 ≥7 个钮时的**全体小号**（2026-10-23 立，2026-10-25 随标准档一起缩）。
 * 为什么必须全体一起缩：只缩吃钮会让同屏图标大小不一（用户报「有的显示更大有的更小」）。
 * ⚠ 这里**不要再写 max-width** —— 那会把上面 `max-width:100%` 的压缩能力换回 rpx 上限，
 * 窄条时图标就从「缩小」退化成「被裁掉两边」。
 */
.ctrl.art.compact .ctrl-img {
  width: 30px;
  height: 25px;
  max-height: 50rpx;
}
.ctrl.art.compact .ctrl-cap {
  margin-top: -4px;
  padding: 0 3px;
  max-width: 38px;
  font-size: 7px;
  line-height: 8px;
}

/* 报杠胶囊的 compact 档：同屏 ≥7 钮时跟着缩（10.9.35「大小统一」的同一条要求） */
.ctrl.declare.compact {
  height: 22px;
  padding: 0 8px;
  font-size: 11px;
}

/* 结算艺术字：面板标题上方的胜利/失败/平局（CDN；未就绪整块不渲染） */
.settle-art {
  display: block;
  width: 320rpx;
  height: 178rpx;
  margin: 0 auto 6rpx;
}

/* 结算面板「胡的是哪张」标注（标题下一行，金色小字，居中） */
.settle-wintile {
  margin: 2rpx 0 8rpx;
  text-align: center;
  font-size: 24rpx;
  line-height: 1.3;
  color: #f6e3a1;
  letter-spacing: 1rpx;
}

/* ---------- 操作带（2026-10-24 第五十轮） ----------
   位置：`.g-status` 与 `.tray-stack`（手牌）之间。WXML 里的堆叠顺序（自上而下）：
     .g-status → .action-bar（报杠 + 吃碰杠胡过 + 自摸/暗杠，恒占）→ .tray-stack（手牌）

   **这一带恒占固定高度，按钮用 absolute 浮在里面**（见下方 .claim-row）。
   为什么必须恒占：2026-10-24 用户报「按钮把牌面挤变形、牌桌忽大忽小」。
   改前报杠行 / 吃碰杠胡行都是**按需占高度的流内行**，一出现就把 .board-overlay
   撑高 44~73px；而画布尺寸由 #game-main 剩余高度反算
   （fitCanvas：w = min(行宽−84, 行高×2)），iPhone 13 横屏实测画布宽
   **526 → 436（−17%）**，两行同现是 **−29%** —— 整块牌桌连牌面一起缩，就是那个观感。
   恒占之后：按钮出现/消失只是「空格住进按钮」，.board-overlay 总高恒定，
   画布永远按同一个行高定尺，再也不跳。

   为什么不「浮在画布上」：`<canvas type="2d">` 是原生组件、独立合成层，
   永远压在 webview DOM 之上（§10.7 实测 fixed + z-index 都被盖还被穿透点击）。
   浮层只剩两个落点：手牌（就是被否掉的半透明遮罩）或画布（不可能）。

   高度的来处：`.ctrl.art` 标准档 图29 + 小注4 + 边距1 = 34px；compact 档 30px。
   2026-10-25（用户报「操作栏和按钮缩小一点，多给牌桌留空间」）：从 44px 收到 **34px** ——
   图 39→29、小注 4px、边距 1px = 34；compact 档 30px。手机上每 1px 高度 = 画布 2px 宽，
   所以这 10px 换来画布宽 +20px（iPhone 13 横屏 438 → 458）。
   高度仍是**常量**：按钮显隐不改布局，这是第五十轮修「忽大忽小」的前提，不能动。 */
.action-bar {
  position: relative;
  width: 100%;
  height: 34px;
  flex-shrink: 0;
}

/*
 * 按钮行：absolute 浮在 .action-bar 里，**不参与流内高度**。
 * align-items:flex-end —— 图 + 小注整体贴着手牌，不往画布方向散。
 * 没有 background：下面就是 .felt，按钮自带 app.wxss 的半透明底，足够辨识。
 */
.claim-row {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  /* 留 1px 缝：小注是深底胶囊，直接贴着手牌上沿会看着「糊在一起」。
     内容高 33px（图29 + 小注净4）≤ 34 − 1，不溢出。 */
  bottom: 1px;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

/*
 * 报杠钮（2026-10-23 起，2026-10-24 并入 .claim-row 的同一排）。
 * 胶囊用**纯文字**（「报杠 四萬」）：34px 高的小钮里放书法体「杠」位图会糊成一团。
 * 与服务端同一口径：`declareOptionsFor()` 要求「自己回合 + 无 pending」，
 * 所以报杠与吃碰杠胡（响应窗口）永不同时出现；而报杠与暗杠/补杠/自摸**可能**
 * 同时出现（都是自己回合）—— 这正是要把两行合成一行、而不是各占一行的原因。
 */
.ctrl.declare {
  height: 25px;
  padding: 0 12px;
  font-size: 12px;
  line-height: 1;
  border-radius: 999rpx;
  /* 极端窄条（iPad 分屏）时跟着 .controls 一起横向压缩，文字省略号收尾 */
  flex-shrink: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  /* 压过 app.wxss 的 button{display:inline-block!important}，
     否则内容按行内基线排、上下留白不均 */
  display: inline-flex !important;
  align-items: center;
  justify-content: center;
  background: rgba(230, 193, 75, 0.18);
  border: 1px solid rgba(230, 193, 75, 0.85);
  color: #f6e3a1;
  white-space: nowrap;
}

.ctrl.declare[disabled] {
  opacity: 0.45;
}

/* 操作区容器：只剩手牌条一层（吃碰杠胡按钮 2026-10-24 起搬到上方的 .claim-row）。
   min-height 与手牌条同高 —— 万一某状态下手牌没渲染，这块也有落脚空间。
   结算态整块不渲染（WXML overPhase），高度归还画布。 */
.tray-stack {
  position: relative;
  width: 100%;
  min-height: 68px;
  display: flex;
  justify-content: center;
}

/*
 * 操作区容器：只剩手牌条一层（按钮已搬到上方恒高的 .action-bar）。
 * min-height 与手牌条同高 —— 万一某状态下手牌没渲染，这块也有落脚空间。
 * 结算态整块不渲染（WXML overPhase），高度归还画布。
 */
.tray-stack {
  position: relative;
  width: 100%;
  min-height: 68px;
  display: flex;
  justify-content: center;
}

/* 纯文字钮（清单未就绪、art 回落时的吃碰杠胡过） */
.controls button {
  height: 30px;
  line-height: 28px;
  font-size: 12px;
  padding: 0 10px;
  margin: 2px 3px;
}

/*
 * 文字回落钮（CDN 操作钮位图未就绪 / 线上服务端清单没带 chi·peng·gang·hu·guo 时，
 * 吃碰杠胡过统一走这里）。2026-10-25 用户报「过」显成小号错位红字、与其它钮不一样 ——
 * 根因是此时 guo 位图没加载（运行中的旧服务端没带该键 / 客户端 7 天 UI 清单缓存过期前
 * 没刷新），WXML 走 `wx:else` 裸文字，又只吃到 app.wxss 全局 button{} 的浅色兜底，
 * 与艺术钮（金底书法图）画风割裂。这里把回落钮**拉到与艺术钮同高同对齐**，并分两级强调：
 *   主操作（吃碰杠胡）金底深字；过(ghost)透明浅描边浅字 —— 都明确是「钮」，不再像裸文字。
 * ⚠ display / margin 必须 !important：要压 app.wxss 全局 button{} 的 inline-block/margin:0 !important。
 * ⚠ 排除 .declare（报杠胶囊有独立样式）与 .art（艺术钮自带图）。
 */
.controls .ctrl:not(.art):not(.declare) {
  display: inline-flex !important;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  height: 30px;
  padding: 0 14px;
  margin: 2px 4px !important;
  font-size: 13px;
  line-height: 1;
  border-radius: 8rpx;
  background: #e6c14b;
  color: #22200f;
  font-weight: 700;
  border: 0;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  flex-shrink: 1;
  min-width: 0;
}
/* 过 / 自摸过：低强调「放弃」钮（与金底主操作区分），但仍是一个干净的胶囊，不裸文字 */
.controls .ctrl:not(.art):not(.declare):not(.primary) {
  background: transparent;
  color: #e8efe9;
  border: 2rpx solid rgba(255, 255, 255, 0.34);
  font-weight: 400;
}
/* 同屏 ≥7 钮的紧凑档：回落钮跟着缩，与 .ctrl.art.compact（图 30×25）保持一行放得下 */
.controls .ctrl:not(.art):not(.declare).compact {
  height: 28px;
  padding: 0 10px;
  font-size: 12px;
}

/*
 * 结算入口「本局结算 ▲」：挂在状态行**最右侧**，与结果文案同一行。
 * 原先它是操作区的第一个子元素（独占一行、紧贴画布底边，下面再接结果文案），
 * 视觉上像被挤在牌桌和文案之间 —— 用户报「本局结算显示位置异常」。
 * 高度必须 ≤ 状态行高度（常态 32rpx / 紧凑档 15px；结算档 `.g-status.over`
 * 44rpx / 22px），否则会被 .g-status 的 overflow:hidden 裁掉一半。
 */
.settle-restore {
  margin-left: 12rpx;
  padding: 0 16rpx;
  height: 30rpx;
  line-height: 30rpx;
  border-radius: 999rpx;
  background: rgba(230, 193, 75, 0.92);
  color: #22200f;
  font-size: 20rpx;
  white-space: nowrap;
  flex-shrink: 0;
}

/* 手牌（scroll-view 横向滚动；窄屏靠 max-width 档缩牌面兜底） */
.hand-tray {
  width: 100%;
  display: flex;
  justify-content: center;
  /* scroll-view 横向滚动；内容不足时由内层 .tray-row 居中 */
  white-space: nowrap;
}

.hand-tray.active .tile-btn {
  border-color: rgba(230, 193, 75, 0.9);
}

.tray-row {
  display: flex;
  /* scroll-x 里必须单行：靠溢出横向滚动，不能 wrap */
  flex-wrap: nowrap;
  /*
   * 2026-10-21 **局中居中对齐**（用户报「手牌应该局中对齐」）。
   * 之前是 space-between「出血对齐」——但条宽是按 14 张满编预算的（handTrayW =
   * max(画布宽, 14 张需求)）：有副露时手上只剩 7~10 张，space-between 把空余全摊到
   * 牌缝里，真机实测 7 张牌被 57px 的大间隙拉散（截图 1016 图素里只有 7 组牌）。
   * 现在双保险居中，两条路径都通向同一个中心轴：
   *   ① width:max-content + margin:0 auto —— 行收缩到内容宽，auto 外边距在条内居中；
   *      内容超宽（iPad 分屏这类真要横滑的极端窄窗）时过约束 → 外边距归 0，
   *      行从左端起排，滚动行为不变（若用 center 居中溢出会左右都溢出、左边滚不到）。
   *   ② justify-content:center —— 万一某台老 webview 不支持 max-content，行仍是整条宽，
   *      靠 flex 居中同样把牌群聚在中间，绝不回到「摊大饼」。
   * 牌群在条内居中 → 条由 board-overlay 的 margin:0 auto 与画布同中心轴（见 WXML）。
   */
  width: max-content;
  margin: 0 auto;
  justify-content: center;
  padding: 1px 0;
  /*
   * 2026-10-21：3D 后仰已废除（用户要「手牌是正的」，见 .tile-btn）。
   * 这一层现在只剩布局职责，不再有任何 transform / perspective。
   */
}

/*
 * 手牌牌面**正视**（2026-10-21，用户报「手牌上的牌上小下大」）。
 * 2026-10-18 引入的 3D 后仰（perspective + rotateX(16°)）让每张牌都是上窄下宽的
 * 梯形 —— 用户要的是「正的」，所以 transform 整条去掉，只保留阴影的层次感。
 * 透视距离变量（CSS 自定义属性）与 handMetrics 的 handPersp 一并废除（无消费者）。
 */
.tile-btn {
  box-shadow: 0 3px 7px rgba(0, 0, 0, 0.34), 0 1px 2px rgba(0, 0, 0, 0.26);
}

/*
 * ===== 手牌牌位：**px 定尺 + 按条宽自适应**（2026-10-21 修「手牌为啥还能滑动」）=====
 *
 * 演进（三次事故，都是同一个病根：两个真相）：
 *   ① 76rpx×92rpx 配 rpx 字号 —— rpx 基准是窗口宽，牌位随窗口放大到 131×158，
 *      还被 aspectFill 上下裁 8.4%（「牌面被切」）。
 *   ② px 定尺 46×66 + px 字号 —— 裁切治好了，但手牌条宽度绑 canvasW（画布 2:1 反算），
 *      手机横屏画布只有 ~410px，14 张要 679px → 必须横向滚动（「还能滑动」）。
 *   ③ 现在：尺寸/字号的**上限**仍是 46×66 / 25·12·27（全档统一 px），但由 fitCanvas
 *      的 handMetrics 按实测行宽算出实际值，经 CSS 变量（牌宽、牌高、摸牌左距、
 *      三个字号、透视距离）写到 .tray-row 上；条不够宽就整排同比缩小，
 *      绝不再出现「放不下只能滚」。
 *      ⚠️ 注释里**不要写出这几个变量的连写形式**（形如 --a/--b/--c）：其中的
 *      「星斜杠」会把注释提前闭合，后面整条规则会被当成无效选择器丢掉 ——
 *      2026-10-21 实测翻车过一次，症状是「设了变量但牌位毫无变化」。
 *
 * 变量默认值 = 上限值：首帧还没量到布局、或极端窄窗缩到 HAND_MIN_W 之前，观感一致。
 * **不要再往 @media 档里写第二份尺寸**（③之前的 ≤700px 档就是那么翻车的）——
 * 自适应已经覆盖了所有宽度，断点档只该管高度/字号以外的布局。
 */
.tile-btn {
  width: var(--tw, 46px);
  height: var(--th, 66px);
  /*
   * border-box：`--tw` 必须是牌的**真实外宽**。改前是 content-box，46px 的 width
   * 外加 1px 边框 → 实际占 48px，而 handMetrics 按 46 算，14 张恰差 28px 排不进条宽
   * （2026-10-21 实测）。边框归位后「牌宽 = --tw」，算式与渲染逐像素一致。
   */
  box-sizing: border-box;
  margin: 0 1px;
  /*
   * 2026-10-20：**不许被压缩**。之前 overflow 时 flex 默认 shrink 会把牌挤成
   * 十几像素宽的细条（用户报「手牌显示异常」：中间几张筒变成竖细条）——
   * 现在条宽由 handMetrics 保证排得下，这里是双保险。
   */
  flex-shrink: 0;
  border-radius: 4px;
  background: #f8f5ec;
  border: 1px solid #c9c2b0;
  display: flex;
  /* 牌面是矢量文字：数牌两行（数字在上、花色在下），风箭牌一行大字 */
  flex-direction: column;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  position: relative;
}

.tile-btn.drawn {
  margin-left: var(--ml-drawn, 8px);
  border-color: #e6c14b;
}

.tile-btn.frozen {
  border-color: #e6c14b;
  opacity: 0.75;
}

.tile-btn.must {
  border-color: #e05a4a;
}

/*
 * 精边框（正精橙 / 副精紫）优先级最高：出牌阶段 `.hand-tray.active` 会把所有手牌描成
 * 金色边框（特异度同为 0,2,1，但这两条在它后面 → 覆盖金色），`.drawn`/`.frozen`/`.must`
 * 特异度更低也会被覆盖 —— 「这是精」比「刚摸/金框/强制出牌」的信息更重要（2026-10-18）。
 */
.hand-tray .tile-btn.fu {
  border-color: #ab47bc;
}

.hand-tray .tile-btn.pi {
  border-color: #ff5722;
}

/*
 * 牌面（2026-10-18 起代码包零图片）：
 *   · **优先 CDN 图片**（`.tile-img` 铺满牌位），地址由后端 `/api/tiles` 清单给出；
 *   · 没取到清单 / 单张加载失败 → 矢量文字兜底：数牌两行（数字在上、花色在下），
 *     风箭牌一行大字。色调按花色区分，小尺寸下靠颜色分辨。
 * 为什么要兜底：官方体检「图片资源 ≤ 200KB、主包 < 1.5MB」，牌面只能走网络，
 * 而域名可能没登记、网络可能不通 —— 兜底保证任何时候牌都看得见。
 */
.tile-img {
  width: 100%;
  height: 100%;
}
.tile-rank {
  /* 三个字号与牌位同比例（handMetrics 的 k），永远装得进牌面 */
  font-size: var(--fs-rank, 25px);
  font-weight: 700;
  line-height: 1;
  color: #1a1a2e;
}

.tile-suit {
  font-size: var(--fs-suit, 12px);
  font-weight: 700;
  line-height: 1;
  margin-top: 1px;
  color: #1a1a2e;
}

.tile-honor {
  font-size: var(--fs-honor, 27px);
  font-weight: 700;
  line-height: 1;
  color: #1a1a2e;
}

/* 万：数字墨色 + 萬字红色（与真实牌面同色系）；条全绿、筒全蓝 */
.tone-m .tile-suit {
  color: #c62828;
}

.tone-s .tile-rank,
.tone-s .tile-suit {
  color: #1b7f3b;
}

.tone-p .tile-rank,
.tone-p .tile-suit {
  color: #1f5fbf;
}

.tone-zhong .tile-honor {
  color: #c62828;
}

.tone-fa .tile-honor {
  color: #1b7f3b;
}

.tone-bai .tile-honor {
  color: #1f5fbf;
}

/* ---------- 表情 / 结算（页内浮层） ----------
   掷骰覆盖层已搬到 app.wxss + templates/dice.wxml（对局页与大厅页共用）。 */
.emote-card {
  width: 640rpx;
}

.emote-targets {
  display: flex;
  gap: 10rpx;
  flex-wrap: wrap;
  margin-bottom: 12rpx;
  /* 2026-10-23 居中：面板是宽卡片，目标钮不足一行时靠左会与下面居中的表情格子错开 */
  justify-content: center;
}

.emote-target {
  height: 60rpx;
  line-height: 56rpx;
  font-size: 22rpx;
  padding: 0 16rpx;
}

.emote-target.on {
  background: rgba(230, 193, 75, 0.18);
  color: #f6e3a1;
  border-color: #e6c14b;
}

.emote-grid {
  max-height: 320rpx;
}

.emote-group {
  font-size: 22rpx;
  color: #9db5a8;
  margin: 8rpx 0;
  /* 与下方居中的表情格子对齐（原来靠左，格子一居中就成了孤立标签） */
  text-align: center;
}

.emote-group.good {
  color: #43c07c;
}

.emote-group.bad {
  color: #e07a6a;
}

.emote-cells {
  display: flex;
  gap: 8rpx;
  flex-wrap: wrap;
  /*
   * 2026-10-23 居中（用户报「互动中的显示出现异常」）：格子是可变宽度的胶囊，
   * 每行能排几个取决于文案长度 —— 原来默认 flex-start，7 个表情排成 6+1，
   * 第二行单个「比心」顶在最左、右侧空出半张卡片，看起来像排版错位。
   * 每行居中后：首行居中、末行单个也居中，视觉上是一个居中的整体。
   */
  justify-content: center;
}

/*
 * 胶囊本体（2026-10-23 「中间的图标没有居中」）。
 *
 * 坑：app.wxss 的 `button { display: inline-block !important }` 会压掉普通
 * `display: flex`，于是图标与文案退化成行内流、按 **baseline** 对齐 ——
 * 16px 的 emoji 顶得比 10px 的文案高半行，视觉上就是「图标没居中」。
 *
 * 修法：用**同样带 !important 的类选择器**（类优先级 > 元素）把它改成
 * inline-flex，再 `align-items: center` + `justify-content: center` 真正居中；
 * 图标与文案之间用 `gap` 固定间距，不再依赖 emoji 字形的自带边距。
 */
.emote-cell {
  display: inline-flex !important;
  align-items: center;
  justify-content: center;
  flex-direction: row;
  gap: 5rpx;
  height: 88rpx;
  font-size: 20rpx;
  padding: 0 14rpx;
  line-height: 1.2;
}

.emote-cell .ico {
  font-size: 32rpx;
}

/*
 * 兜底（2026-10-23）：万一某些基础库版本的 `<button>` 不吃 display 覆盖，
 * 归位后仍是行内流 —— 那就让两个 text 都用 vertical-align: middle 对齐中线，
 * 避免 16px 的 emoji 按 baseline 顶高。flex 生效时这条被忽略，无副作用。
 */
.emote-cell text {
  vertical-align: middle;
}

.settle-card {
  width: 94%;
  max-width: 1200rpx;
}

.settle-body {
  max-height: 52vh;
  /*
   * 2026-10-27（用户报「结算弹框现在无法滚动和缩小」）：
   * .layer-card 是 flex 列且 max-height:86vh；<scroll-view> 默认 min-height:auto 会**按内容撑住不缩**
   * （微信 scroll-view 不套用 CSS overflow，不会像 Chromium 那样自动取 min-size:0）。
   * 于是内容一多，卡片总高 > 86vh → overflow:hidden 把底部按钮/尾巴裁掉、scroll-view 也拿不到
   * 确定高度而划不动。显式 min-height:0 让 flex 压得下去，scroll-view 得到确定的计算高即可滚动
   * （与 .panel-body 的 flex:1 + min-height:0 同一手法，见 §10.9.62）。
   */
  min-height: 0;
  flex-shrink: 1;
}

.settle-note {
  font-size: 22rpx;
  color: #b9cfc2;
  padding: 6rpx 0;
}

.settle-totals {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #f6e3a1;
}

/* 解散结算表「总积分」列加粗（.total-col 仅在 lobby.wxss 定义，页级作用域不覆盖本页）。
   红绿配色由全局 app.wxss 的 .pos/.neg 负责，此处只补加粗。 */
.total-col {
  font-weight: 700;
}

/*
 * 矮视口（手机横屏）：px 定尺 —— rpx 随屏宽放大，宽而矮的窗口里会把 HUD/手牌条
 * 一起撑爆、把画布挤没。这里把非画布 chrome 压到最小；手牌与提示都已改为盖在
 * 画布下方流内排布，与画布同属一屏（见 §10.8⑦）。
 */
@media (max-height: 680px) {
  .game {
    padding-top: calc(3px + max(var(--safe-t, 0px), env(safe-area-inset-top, 0px)));
    padding-right: calc(8px + max(var(--safe-r, 0px), env(safe-area-inset-right, 0px)));
    padding-bottom: calc(3px + env(safe-area-inset-bottom, 0px));
    padding-left: calc(8px + max(var(--safe-l, 0px), env(safe-area-inset-left, 0px)));
  }

  .banner {
    margin-bottom: 4px;
    padding: 4px 10px;
    font-size: 11px;
  }

  /* 自绘顶栏紧凑档：24px 高（竖档 28px），信息字号压到 10/11px */
  .g-top {
    height: 24px;
    gap: 6px;
    margin-bottom: 1px;
  }

  .g-top-back {
    width: 22px;
    height: 22px;
    line-height: 20px;
    font-size: 15px;
  }

  .g-top-info {
    gap: 6px;
  }

  .g-top-item,
  .g-top .code {
    font-size: 10px;
  }

  .g-top .badge {
    font-size: 9px;
    padding: 0 6px;
  }

  .g-top-cap {
    width: 104px;
  }

  /*
   * 侧边轨紧凑档（间距在 .rail-inner 上）。
   *
   * 2026-10-25 第五十二轮：32px/6px 在手机横屏装不下了 —— 轨顶改到「胶囊下沿」之后，
   * 可用带只剩 game-main 高 − 胶囊侵入（≈15px）：
   *   · iPhone 13 横屏 → 212px；
   *   · iPhone SE 横屏 → 197px；
   *   · 安卓横屏带 24px 状态栏 → 188px（状态栏把 100vh 里的内容也吃掉一截）。
   * 6 个钮 × 32 + 5 × 6 = 222px 全都装不下 → 要滚 10~34px，「退出」「✕」被压在底部。
   *
   * 收紧到 28px/3px = 6×28 + 5×3 = **183px**：上面三档分别留 29 / 14 / 5px 余量，
   * 都不需要滚动。为什么是 28 而不是 30：30px 时安卓那档还差 7px（会触发滚动、
   * 底部按钮被切一角），而 28 与 30 在视觉上几乎无差别 —— 与其留一个「偶尔要滚」的
   * 半吊子状态，不如一次收到能全覆盖。
   * 「退出」两字在 28px 圆里用 11px 字号（22px 宽）刚好放得下。
   * 再极端的窗口（< 340px 高）仍由 `.rail` 的 overflow-y:auto 兜底，
   * 从顶部滚、**不会溢出到胶囊或手牌上**。
   */
  .rail-inner {
    gap: 2px;
  }

  .rail-btn {
    width: 28px !important;
    height: 28px;
    line-height: 26px;
    font-size: 13px;
  }

  .rail-btn.exit {
    font-size: 11px;
  }

  .rail-badge {
    min-width: 14px;
    height: 14px;
    line-height: 14px;
    font-size: 9px;
  }

  /* 弹层面板紧凑档：贴边距更小、消息/记录字号 10px */
  .panel-card {
    width: min(86vw, 560px);
    border-radius: 10px;
  }

  .chat-card {
    width: min(78vw, 480px);
  }

  .panel-head {
    padding: 4px 8px;
  }

  .panel-title {
    font-size: 12px;
  }

  .panel-x {
    width: 22px !important;
    height: 22px;
    line-height: 20px;
    font-size: 11px;
  }

  .panel-body {
    padding: 3px 8px;
  }

  .chat-log,
  .log-list {
    padding: 4px 8px;
  }

  .chat-msg {
    font-size: 11px;
  }

  .log-row {
    font-size: 10px;
    padding: 1px 0;
  }

  .log-seat {
