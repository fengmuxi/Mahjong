.game {
  /* 横向 padding 吃进刘海 / 挖孔内缩。两个来源取大者（max）：
     ① var(--safe-l/r)：computeSafeInsets 用「探测元素」量出的 env() 真实值 +
        wx.getWindowInfo().safeArea（部分安卓机型横屏只认这个）；
     ② env(safe-area-inset-left/right)：iOS 横屏的可靠来源。
     无刘海 / 挖孔设备两者都是 0px，布局与原样一致。底部安全区仍走 env()（Home 指示条）。 */
  padding: 8rpx calc(16rpx + max(var(--safe-r, 0px), env(safe-area-inset-right, 0px))) 12rpx
    calc(16rpx + max(var(--safe-l, 0px), env(safe-area-inset-left, 0px)));
  height: 100vh;
  display: flex;
  flex-direction: column;
  /* 浮层的定位基准：.layer 在 game 页改为 absolute（见下），必须有个 relative 祖先 */
  position: relative;
}

/*
 * 浮层定位（2026-10-17 修）：
 * app.wxss 的 .layer 是 position:fixed + inset:0 弹性居中，基准是小程序**文档**而非
 * 可视区 —— 本页 .game 高 100vh（含导航栏区），文档比可视区高出一截，fixed 卡片
 * 实测比屏心低 ~23 CSS px、左 ~34 CSS px（横向偏移疑与页面溢出/滚动有关）。
 * 改为 absolute + inset:0：基准变成 .game 的 padding box（上面已加 position:relative），
 * 即本页整个可视流区，卡片随之精确居中；导航栏是原生 UI 在流区之外，本就无需 Dim。
 * 注意只覆盖 game 页：lobby 页仍用 app.wxss 的 fixed 版。
 */
.game .layer {
  position: absolute;
}

/* ---------- HUD ---------- */
.game-hud {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-bottom: 6rpx;
}

.hud-group {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-wrap: wrap;
  min-width: 0;
}

/* 右侧按钮组不参与压缩：按钮已是内容宽，再压只会让文字折行 */
.game-hud .hud-group:last-child {
  flex-shrink: 0;
}

.hud-label {
  font-size: 20rpx;
  color: #9db5a8;
}

.hud-sep {
  color: rgba(255, 255, 255, 0.15);
  font-size: 20rpx;
}

.hud-item {
  font-size: 22rpx;
  color: #b9cfc2;
  /* jingText 很长（赣州：\"正精 北 · 副精 东（其余 10 张结算揭晓）\"）：
     不截断会在窄宽横屏把 HUD 撑成两行、挤掉牌桌高度 —— 单行省略号保布局 */
  min-width: 0;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.game-hud button {
  height: 52rpx;
  line-height: 48rpx;
  font-size: 22rpx;
  padding: 0 16rpx;
}

/* 收起态聊天钮（HUD 内）：未读红点跟在 emoji 后面 */
.chat-fab {
  position: relative;
}

.fab-badge {
  margin-left: 4rpx;
  color: #e07a6a;
  font-weight: 700;
}

/* ---------- 画布 + 左右侧栏 ---------- */
/*
 * gap 必须与 game.js 的 SIDE_GAP 一致（px，不是 rpx）：fitCanvas 用
 * 「行宽 − 侧栏宽 − gap×栏数」反算画布宽度，rpx 会随屏宽缩放，一旦对不上
 * 画布就会溢出或留缝。所以这里刻意写死 px。
 */
.game-main {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: row;
  gap: 6px;
}

/* 左右侧栏：宽度由 fitCanvas 算好后写在行内 style 上（px），这里只管外观 */
.side-col {
  flex-shrink: 0;
  min-width: 0;
  display: flex;
  flex-direction: column;
  background: rgba(16, 26, 21, 0.96);
  border: 2rpx solid rgba(255, 255, 255, 0.14);
  border-radius: 14rpx;
  overflow: hidden;
}

.side-title {
  padding: 8rpx 12rpx;
  font-size: 22rpx;
  color: #f6e3a1;
  border-bottom: 2rpx solid rgba(255, 255, 255, 0.08);
  flex-shrink: 0;
}

.side-title-inline {
  font-size: 22rpx;
  color: #f6e3a1;
}

.side-body {
  flex: 1;
  min-height: 0;
  padding: 6rpx 10rpx;
}

/* 窄栏里一行放不下「座位 + 动作 + 牌 + 备注」→ 允许换行，别横向溢出。
   座位名不再吃 min-width：侧栏可能只有 110px 宽，留着固定宽度会把每条记录挤成两行。 */
.side-body .log-row {
  flex-wrap: wrap;
}

.side-body .log-seat {
  min-width: 0;
}

/* 侧栏聊天标题行右侧的快捷语 / 表情钮（底部输入行在窄栏里放不下四个元素） */
.chat-bar-tools {
  display: flex;
  align-items: center;
  gap: 4px;
  margin-left: auto;
}

.chat-bar-tools .chat-ico {
  width: 44rpx !important;
  height: 44rpx;
  line-height: 42rpx;
  font-size: 20rpx;
}

.canvas-wrap {
  flex: 1;
  min-width: 0;
  min-height: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.canvas-wrap canvas {
  display: block;
  border-radius: 12rpx;
}

/*
 * 浮层打开期间藏掉牌桌画布（JS 侧 modalOpen → on-modal）。
 * 原因：<canvas type="2d"> 是原生组件，合成层级在 DOM 之上 —— fixed 的 .layer
 * Dim 不到它、盖不住它，且浮层打开时牌桌仍会被穿透点击（能点牌出牌）。
 * 用 class 切 display 而非 wx:if：后者会销毁 canvas 节点，this.table 实例
 * 与已绘牌面一起失效。关闭时 syncModal 里会补 render + fitCanvas。
 */
.canvas-wrap canvas.on-modal {
  display: none;
}

/*
 * 底部操作区：提示 → 吃碰杠胡 → 手牌，在画布下方**流内**排布。
 * （曾试图用 cover-view 盖在牌桌下缘，2026-10-17 实测否决：开发者工具里 cover-view
 *  同样盖不住原生 canvas —— 实时 DOM 里整块操作区都渲染了却完全不可见。详见 §10.8⑦。）
 * **不要在这里再写 padding-bottom: env(safe-area-inset-bottom)** —— `.game` 的底部内边距
 * 已经算过一份，再加一份会让底部多空出 ~21px（横屏 home indicator），那段高度本该归画布。
 */
.board-overlay {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex-shrink: 0;
}

/*
 * 刘海/挖孔探测元素（computeSafeInsets 用）：宽度直接写成 env(safe-area-inset-left/right)，
 * SelectorQuery 量它的宽 = 当前运行时里 env() 的真实解析值。0 高 + absolute + 不可见，
 * 不占布局、不挡点击。
 */
.safe-probe {
  position: absolute;
  left: 0;
  top: 0;
  height: 0;
  visibility: hidden;
  pointer-events: none;
}

#safe-probe-l {
  width: env(safe-area-inset-left, 0px);
}

#safe-probe-r {
  width: env(safe-area-inset-right, 0px);
}

/*
 * 提示浮层（事件/错误 toast）在局内改到手牌条（出牌器）**上方**——
 * app.wxss 的 `.toast` 是 fixed bottom:40rpx，正好压在手牌条上（用户截图红框）。
 * fixed 相对视口定位，bottom 要跨过整个操作区：状态行 32rpx + 间距 4rpx
 * + 手牌条 96rpx + 页脚 padding 12rpx + 间隙 12rpx ≈ 156rpx。
 * 浮层盖住的是牌桌下沿的牌河（提示 3s 自动消失，不常驻）。
 * 手机横屏紧凑档的 px 精确定位在下方 media 块里。
 */
.toast {
  bottom: 156rpx;
}

/* ---------- 局内聊天（流内右列；窄屏展开 / 宽屏常驻） ---------- */
.chat {
  flex-shrink: 0;
  align-self: stretch;
  width: 420rpx;
  min-width: 0;
  background: rgba(16, 26, 21, 0.96);
  border: 2rpx solid rgba(255, 255, 255, 0.14);
  border-radius: 14rpx;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/*
 * 宽屏侧栏模式：宽度已由 fitCanvas 按剩余空间算好（行内 style），
 * 必须把 420rpx / 紧凑档的 32vw + min-width:240px + max-width:320px 全部让开，
 * 否则 min-width 会把内联宽度顶回去（min-width 优先于 width）。
 */
.chat.sided {
  width: auto;
  min-width: 0;
  max-width: none;
}

/* 侧栏模式没有页签，聊天区要吃掉整列高度（不再受 300rpx 上限约束） */
.chat.sided .chat-log {
  max-height: none;
}

.chat-bar {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 10rpx;
  border-bottom: 2rpx solid rgba(255, 255, 255, 0.08);
}

.chat-tab {
  height: 48rpx;
  line-height: 44rpx;
  font-size: 22rpx;
  padding: 0 14rpx;
  background: transparent;
}

.chat-tab.active {
  background: rgba(230, 193, 75, 0.18);
  color: #f6e3a1;
}

.chat-min {
  /* margin-left:auto + width 都要 !important：前者被 app.wxss 的 margin:0!important
     覆盖、后者破 button:not([size='mini']) 的内置 184px 定宽 */
  margin-left: auto !important;
  width: 48rpx !important;
  height: 48rpx;
  line-height: 44rpx;
  padding: 0;
  text-align: center;
  font-size: 24rpx;
}

.chat-log,
.log-list {
  flex: 1;
  min-height: 0;
  max-height: 300rpx;
  padding: 8rpx 12rpx;
}

.chat-msg {
  font-size: 22rpx;
  line-height: 1.6;
  word-break: break-all;
}

.chat-msg.self .chat-name {
  color: #f6e3a1;
}

.chat-name {
  color: #9db5a8;
}

.log-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 20rpx;
  padding: 3rpx 0;
}

.log-seat {
  color: #9db5a8;
  min-width: 96rpx;
}

.log-action {
  padding: 0 10rpx;
  border-radius: 6rpx;
  background: rgba(255, 255, 255, 0.08);
}

.log-action.hu {
  background: rgba(229, 72, 77, 0.25);
  color: #ef9a9a;
}

.log-action.gang,
.log-action.angang,
.log-action.bugang {
  background: rgba(255, 152, 0, 0.22);
  color: #ffb74d;
}

.log-action.peng {
  background: rgba(33, 150, 243, 0.22);
  color: #64b5f6;
}

.log-action.chi {
  background: rgba(76, 175, 80, 0.22);
  color: #81c784;
}

/* 快捷语 / 表情：scroll-view 才能真正滚动（普通 view 的 overflow 不生效） */
.chat-pop {
  max-height: 200rpx;
}

.chat-pop-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  padding: 8rpx 12rpx;
}

.chat-chip {
  height: 52rpx;
  line-height: 48rpx;
  font-size: 22rpx;
  padding: 0 14rpx;
}

.chat-input-row {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 8rpx 10rpx;
  border-top: 2rpx solid rgba(255, 255, 255, 0.08);
}

.chat-ico {
  /* !important 同上：破内置 184px 定宽 */
  width: 52rpx !important;
  height: 52rpx;
  line-height: 48rpx;
  padding: 0;
  text-align: center;
  font-size: 24rpx;
}

.chat-input {
  flex: 1;
  /* input 默认有 ~150px 的固有宽度，不给 min-width:0 会把「发送」挤出侧栏 */
  min-width: 0;
  height: 52rpx;
  padding: 0 12rpx;
  border-radius: 8rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.14);
  background: rgba(0, 0, 0, 0.25);
  color: #e8efe9;
  font-size: 22rpx;
}

.chat-send {
  height: 52rpx;
  line-height: 48rpx;
  font-size: 22rpx;
  padding: 0 16rpx;
}

/* ---------- 画布下方的操作区（提示 / 控件 / 手牌） ---------- */
/*
 * 状态行恒占一行：左文案 + 右倒计时。**不要用 wx:if 增删这一行** ——
 * 一增一删会让操作区总高变化，画布随之重排跳动（用户报「报杠提示把牌桌往上顶」）。
 * 高度锁死 + 文案省略号，保证任何状态下总高都不变。
 */
.g-status {
  width: 100%;
  height: 32rpx;
  line-height: 32rpx;
  margin: 2rpx 0;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.g-status-text {
  font-size: 24rpx;
  color: #e8efe9;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  flex-shrink: 1;
  min-width: 0;
}

/*
 * 结算态的状态行：手牌带退场后这块就是操作区的全部内容，可以放宽一点
 * 让胡牌结果和「本局结算 ▲」都看得清。高度变化发生在「进入/离开结算」这一帧，
 * JS 侧 chromeKey 翻转会补一次 fitCanvas()，画布跟着重排，不会留下空隙。
 */
.g-status.over {
  height: 44rpx;
  line-height: 44rpx;
}

.g-status.over .g-status-text {
  font-size: 26rpx;
  color: #f6e3a1;
}

/* 响应倒计时：并进状态行（原先绝对定位在画布顶部，会被原生 canvas 盖住） */
.countdown {
  margin-left: 10rpx;
  padding: 0 10rpx;
  border-radius: 999rpx;
  background: rgba(0, 0, 0, 0.45);
  color: #f6e3a1;
  font-size: 22rpx;
  line-height: 30rpx;
  white-space: nowrap;
  flex-shrink: 0;
}

/* 错误提示：占位替换状态文案（同一行），不再单独占一行 —— 否则一出现就把
   操作区顶高、画布重排（线上旧服务端每 10s 回一次「未知消息」时最明显）。 */
.g-status-text.err {
  color: #e07a6a;
}

.controls {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
}

/* 操作区容器：手牌与遮罩共用同一块区域，遮罩绝对定位盖在手牌上。
   min-height 与手牌条同高 —— 万一某状态下手牌没渲染，遮罩也要有落脚空间。
   结算态整块不渲染（WXML overPhase），高度归还画布。 */
.tray-stack {
  position: relative;
  width: 100%;
  min-height: 96rpx;
  display: flex;
  justify-content: center;
}

/*
 * 吃碰杠胡遮罩：半透明盖在手牌上，手牌仍可见（用户要看牌决定碰还是胡）。
 * 遮罩与手牌都是普通 DOM —— DOM 之间互相覆盖不受原生 canvas 限制（canvas 只挡在
 * 它自己的矩形上方，操作区已在画布下方）。
 */
.claim-mask {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  top: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: rgba(8, 18, 13, 0.62);
}

/* 遮罩里的按钮自带外观（半透明底上要保证可辨识） */
.controls button {
  height: 60rpx;
  line-height: 58rpx;
  font-size: 24rpx;
  padding: 0 20rpx;
  margin: 4rpx 5rpx;
}

/*
 * 结算入口「本局结算 ▲」：挂在状态行**最右侧**，与结果文案同一行。
 * 原先它是操作区的第一个子元素（独占一行、紧贴画布底边，下面再接结果文案），
 * 视觉上像被挤在牌桌和文案之间 —— 用户报「本局结算显示位置异常」。
 * 高度必须 ≤ 状态行高度（常态 32rpx / 紧凑档 15px；结算档 `.g-status.over`
 * 44rpx / 22px），否则会被 .g-status 的 overflow:hidden 裁掉一半。
 */
.settle-restore {
  margin-left: 12rpx;
  padding: 0 16rpx;
  height: 30rpx;
  line-height: 30rpx;
  border-radius: 999rpx;
  background: rgba(230, 193, 75, 0.92);
  color: #22200f;
  font-size: 20rpx;
  white-space: nowrap;
  flex-shrink: 0;
}

/* 手牌（scroll-view 横向滚动；窄屏靠 max-width 档缩牌面兜底） */
.hand-tray {
  width: 100%;
  display: flex;
  justify-content: center;
  /* scroll-view 横向滚动；内容不足时由内层 .tray-row 居中 */
  white-space: nowrap;
}

.hand-tray.active .tile-btn {
  border-color: rgba(230, 193, 75, 0.9);
}

.tray-row {
  display: flex;
  /* scroll-x 里必须单行：靠溢出横向滚动，不能 wrap */
  flex-wrap: nowrap;
  justify-content: center;
  padding: 2rpx 0;
}

.tile-btn {
  width: 76rpx;
  height: 92rpx;
  margin: 0 3rpx;
  border-radius: 8rpx;
  background: #f8f5ec;
  border: 2rpx solid #c9c2b0;
  display: flex;
  /* 牌面是矢量文字：数牌两行（数字在上、花色在下），风箭牌一行大字 */
  flex-direction: column;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  position: relative;
}

.tile-btn.drawn {
  margin-left: 16rpx;
  border-color: #e6c14b;
}

.tile-btn.frozen {
  border-color: #e6c14b;
  opacity: 0.75;
}

.tile-btn.must {
  border-color: #e05a4a;
}

/*
 * 精边框（正精橙 / 副精紫）优先级最高：出牌阶段 `.hand-tray.active` 会把所有手牌描成
 * 金色边框（特异度同为 0,2,1，但这两条在它后面 → 覆盖金色），`.drawn`/`.frozen`/`.must`
 * 特异度更低也会被覆盖 —— 「这是精」比「刚摸/金框/强制出牌」的信息更重要（2026-10-18）。
 */
.hand-tray .tile-btn.fu {
  border-color: #ab47bc;
}

.hand-tray .tile-btn.pi {
  border-color: #ff5722;
}

/*
 * 牌面（2026-10-18 起代码包零图片）：
 *   · **优先 CDN 图片**（`.tile-img` 铺满牌位），地址由后端 `/api/tiles` 清单给出；
 *   · 没取到清单 / 单张加载失败 → 矢量文字兜底：数牌两行（数字在上、花色在下），
 *     风箭牌一行大字。色调按花色区分，小尺寸下靠颜色分辨。
 * 为什么要兜底：官方体检「图片资源 ≤ 200KB、主包 < 1.5MB」，牌面只能走网络，
 * 而域名可能没登记、网络可能不通 —— 兜底保证任何时候牌都看得见。
 */
.tile-img {
  width: 100%;
  height: 100%;
}
.tile-rank {
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1;
  color: #1a1a2e;
}

.tile-suit {
  font-size: 20rpx;
  font-weight: 700;
  line-height: 1;
  margin-top: 2rpx;
  color: #1a1a2e;
}

.tile-honor {
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1;
  color: #1a1a2e;
}

/* 万：数字墨色 + 萬字红色（与真实牌面同色系）；条全绿、筒全蓝 */
.tone-m .tile-suit {
  color: #c62828;
}

.tone-s .tile-rank,
.tone-s .tile-suit {
  color: #1b7f3b;
}

.tone-p .tile-rank,
.tone-p .tile-suit {
  color: #1f5fbf;
}

.tone-zhong .tile-honor {
  color: #c62828;
}

.tone-fa .tile-honor {
  color: #1b7f3b;
}

.tone-bai .tile-honor {
  color: #1f5fbf;
}

/* ---------- 表情 / 结算（页内浮层） ----------
   掷骰覆盖层已搬到 app.wxss + templates/dice.wxml（对局页与大厅页共用）。 */
.emote-card {
  width: 640rpx;
}

.emote-targets {
  display: flex;
  gap: 10rpx;
  flex-wrap: wrap;
  margin-bottom: 12rpx;
}

.emote-target {
  height: 60rpx;
  line-height: 56rpx;
  font-size: 22rpx;
  padding: 0 16rpx;
}

.emote-target.on {
  background: rgba(230, 193, 75, 0.18);
  color: #f6e3a1;
  border-color: #e6c14b;
}

.emote-grid {
  max-height: 320rpx;
}

.emote-group {
  font-size: 22rpx;
  color: #9db5a8;
  margin: 8rpx 0;
}

.emote-group.good {
  color: #43c07c;
}

.emote-group.bad {
  color: #e07a6a;
}

.emote-cells {
  display: flex;
  gap: 8rpx;
  flex-wrap: wrap;
}

.emote-cell {
  height: 88rpx;
  font-size: 20rpx;
  padding: 0 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  line-height: 1.2;
}

.emote-cell .ico {
  font-size: 32rpx;
}

.settle-card {
  width: 94%;
  max-width: 1200rpx;
}

.settle-body {
  max-height: 52vh;
}

.settle-note {
  font-size: 22rpx;
  color: #b9cfc2;
  padding: 6rpx 0;
}

.settle-totals {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #f6e3a1;
}

/*
 * 矮视口（手机横屏）：px 定尺 —— rpx 随屏宽放大，宽而矮的窗口里会把 HUD/手牌条
 * 一起撑爆、把画布挤没。这里把非画布 chrome 压到最小；手牌与提示都已改为盖在
 * 画布下方流内排布，与画布同属一屏（见 §10.8⑦）。
 */
@media (max-height: 680px) {
  .game {
    padding: 4px calc(8px + max(var(--safe-r, 0px), env(safe-area-inset-right, 0px)))
      calc(4px + env(safe-area-inset-bottom, 0px))
      calc(8px + max(var(--safe-l, 0px), env(safe-area-inset-left, 0px)));
  }

  .banner {
    margin-bottom: 4px;
    padding: 4px 10px;
    font-size: 11px;
  }

  .game-hud {
    margin-bottom: 2px;
    gap: 6px;
  }

  .hud-group {
    gap: 6px;
  }

  .hud-label,
  .hud-sep {
    font-size: 10px;
  }

  .hud-item {
    font-size: 11px;
  }

  .badge {
    font-size: 10px;
    padding: 1px 8px;
  }

  /* HUD 里的房间码：app.wxss 的 .code 只有 rpx 字重/字距，没有矮视口字号 */
  .code {
    font-size: 11px;
  }

  .game-hud button {
    height: 26px;
    line-height: 24px;
    font-size: 11px;
    padding: 0 10px;
  }

  .fab-badge {
    font-size: 10px;
  }

  .game-main {
    gap: 6px;
  }

  .side-col {
    border-radius: 10px;
  }

  .side-title {
    padding: 4px 6px;
    font-size: 11px;
  }

  .side-title-inline {
    font-size: 11px;
  }

  .side-body {
    padding: 3px 5px;
  }

  /* 聊天列：随视口宽取 32vw，封顶 320px（矮宽窗口里 vw 比 rpx 可控） */
  .chat {
    width: 32vw;
    min-width: 240px;
    max-width: 320px;
    border-radius: 10px;
  }

  .chat-bar {
    padding: 4px 6px;
    gap: 4px;
  }

  .chat-tab {
    height: 26px;
    line-height: 24px;
    font-size: 11px;
    padding: 0 8px;
  }

  .chat-min {
    width: 26px !important;
    height: 26px;
    line-height: 24px;
    font-size: 12px;
  }

  .chat-log,
  .log-list {
    max-height: none;
    padding: 4px 8px;
  }

  .chat-msg {
    font-size: 11px;
  }

  .log-row {
    font-size: 10px;
    padding: 1px 0;
  }

  .log-seat {
    min-width: 56px;
  }

  .chat-pop {
    max-height: 30vh;
  }

  .chat-pop-row {
    gap: 6px;
    padding: 5px 8px;
  }

  .chat-chip {
    height: 26px;
    line-height: 24px;
    font-size: 11px;
    padding: 0 8px;
  }

  .chat-input-row {
    padding: 4px 6px;
    gap: 4px;
  }

  .chat-ico {
    width: 28px !important;
    height: 28px;
    line-height: 26px;
    font-size: 13px;
  }

  .chat-bar-tools .chat-ico {
    width: 22px !important;
    height: 22px;
    line-height: 20px;
    font-size: 11px;
  }

  .chat-input {
    height: 28px;
    font-size: 11px;
    padding: 0 8px;
  }

  .chat-send {
    height: 28px;
    line-height: 26px;
    font-size: 11px;
    padding: 0 10px;
  }

  /* 浮层按钮行：app.wxss 的 .btn-row button 是 72rpx 竖档，矮宽窗口里 rpx 被放大
     →「关闭」这类单钮会被撑成巨型按钮（2026-10-17 用户报「开关异常」）。这里压回 px 档。 */
  .btn-row {
    margin-top: 2px;
  }

  .btn-row button {
    height: 30px;
    line-height: 28px;
    padding: 0 12px;
    font-size: 12px;
  }

  /* ---- 画布下方操作区 ---- */
  /* 状态行恒占 15px（左文案 + 右倒计时），控件出现/消失不改变总高 → 画布不跳 */
  .g-status {
    height: 15px;
    line-height: 15px;
    margin: 1px 0;
  }
  .g-status-text {
    font-size: 12px;
  }

  .g-status-text.err {
    font-size: 11px;
  }

  /* 结算态状态行（手牌带已退场）：一行结果 + 右侧「本局结算 ▲」 */
  .g-status.over {
    height: 22px;
    line-height: 22px;
  }

  .g-status.over .g-status-text {
    font-size: 12px;
  }

  .g-status.over .settle-restore {
    height: 18px;
    line-height: 18px;
    font-size: 11px;
  }

  .countdown {
    margin-left: 5px;
    padding: 0 5px;
    font-size: 11px;
    line-height: 14px;
  }

  .controls button {
    height: 30px;
    line-height: 28px;
    font-size: 12px;
    padding: 0 12px;
    margin: 0 3px;
  }

  .settle-restore {
    margin-left: 6px;
    padding: 0 8px;
    height: 14px;
    line-height: 14px;
    font-size: 10px;
  }

  .hand-tray .tray-row {
    padding: 1px 0;
  }

  .tray-stack {
    min-height: 68px;
  }

  /*
   * 手牌 46×66（原 46×60）。**宽度总占位一分不变**（14 张 × 48 = 672 + 定张 8 = 680，
   * 与 46×60 + 1.5px 边距时完全一样），所以不会让任何一台设备从「放得下」变成「要横滑」；
   * 多出来的 6px 全给高度：46/66 = 0.697，几乎等于真实牌面比例 0.688（原来 0.767 偏方）。
   * 牌面字号 +3px 是这次观感提升的主要来源（数字 25 / 花色 12 / 风箭 27）。
   */
  .tile-btn {
    width: 46px;
    height: 66px;
    margin: 0 1px;
    border-radius: 4px;
  }

  .tile-btn.drawn {
    margin-left: 8px;
  }

  /* 牌面字号跟手牌尺寸走：46×66 下数字 25px / 花色 12px，风箭牌 27px */
  .tile-rank {
    font-size: 25px;
  }

  .tile-suit {
    font-size: 12px;
    margin-top: 1px;
  }

  .tile-honor {
    font-size: 27px;
  }

  /* 浮层 */
  .layer-card {
    width: 88%;
    padding: 14px 16px;
  }

  .layer-title {
    font-size: 15px;
    margin-bottom: 8px;
  }

  .layer-text {
    font-size: 12px;
    margin-bottom: 12px;
  }

  .tbl-row {
    font-size: 12px;
  }

  .tbl-cell {
    padding: 3px 4px;
  }

  .emote-card {
    width: 70vw;
    max-width: 480px;
  }

  .emote-target {
    height: 28px;
    line-height: 26px;
    font-size: 11px;
    padding: 0 10px;
  }

  .emote-grid {
    max-height: 36vh;
  }

  .emote-group {
    font-size: 11px;
    margin: 4px 0;
  }

  .emote-cell {
    height: 44px;
    font-size: 10px;
    padding: 0 8px;
  }

  .emote-cell .ico {
    font-size: 18px;
  }

  .settle-card {
    width: 96%;
  }

  .settle-body {
    max-height: 56vh;
  }

  .settle-note {
    font-size: 11px;
    padding: 3px 0;
  }

  .settle-totals {
    font-size: 12px;
    margin-top: 6px;
  }

  .toast {
    font-size: 12px;
    padding: 6px 12px;
    /* 提示浮层改到手牌条（出牌器）**上方**：fixed 的 bottom 要跨过整个操作区
       （状态行 15px + 间距 2px + 手牌条 68px + 页脚 padding 4px + 6px 间隙），
       并叠上 iPhone 底部安全区。盖住的是牌桌下沿的牌河（提示 3s 自动消失）。 */
    bottom: calc(95px + env(safe-area-inset-bottom, 0px));
  }
}

/*
 * 窄横屏（≤700 CSS px）：手牌 13~14 张一行放不下，缩小牌面兜底
 * （scroll-view 能滚，此档只是让整排更容易一屏放下）。
 * 断点 620 → 700：手牌放大到 46px 后，14 张 + 间距需要 683px，
 * 667/568 这类窄横屏必须先缩档，否则会横向溢出（虽然能滚，但看不全）。
 */
@media (max-width: 700px) {
  /* 极窄横屏（≤700px）：14 张放不下 46px，退到 39×55 —— 总占位 574px，667 也放得下 */
  .tile-btn {
    width: 39px;
    height: 55px;
    margin: 0 1px;
  }

  .tile-btn.drawn {
    margin-left: 6px;
  }

  .tile-rank {
    font-size: 21px;
  }

  .tile-suit {
    font-size: 10px;
  }

  .tile-honor {
    font-size: 23px;
  }

  .controls button {
    height: 28px;
    line-height: 26px;
    font-size: 12px;
    padding: 0 10px;
    margin: 0 2px;
  }
}