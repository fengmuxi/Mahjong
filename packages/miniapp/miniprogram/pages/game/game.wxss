  /*
   * 2026-10-21：`.tile-btn / .tile-rank / .tile-suit / .tile-honor` 的四条
   * 覆盖已经删掉 —— 牌位与字号现在是**全档统一的 px 定尺**（46×66 / 25/12/27，
   * 见文件上方「手牌牌位」注释）。这里再写一遍只会制造第二个真相，
   * 日后改一处忘了另一处就会重演「rpx 尺寸配 px 字号」的裁切事故。
   */

  /* 浮层 */
  .layer-card {
    width: 88%;
    padding: 14px 16px;
  }

  .layer-title {
    font-size: 15px;
    margin-bottom: 8px;
  }

  .layer-text {
    font-size: 12px;
    margin-bottom: 12px;
  }

  .tbl-row {
    font-size: 12px;
  }

  .tbl-cell {
    padding: 3px 4px;
  }

  /* 操作带紧凑档：.action-bar 恒高不变（34px），只缩里面的钮 */
  .ctrl.declare {
    height: 22px;
    padding: 0 8px;
    font-size: 11px;
  }

  .emote-card {
    width: 70vw;
    max-width: 480px;
  }

  .emote-target {
    height: 28px;
    line-height: 26px;
    font-size: 11px;
    padding: 0 10px;
  }

  .emote-grid {
    max-height: 36vh;
  }

  .emote-group {
    font-size: 11px;
    margin: 4px 0;
  }

  .emote-cell {
    height: 44px;
    font-size: 10px;
    padding: 0 8px;
  }

  .emote-cell .ico {
    font-size: 18px;
  }

  .settle-card {
    width: 96%;
  }

  .settle-body {
    max-height: 56vh;
  }

  .settle-note {
    font-size: 11px;
    padding: 3px 0;
  }

  .settle-totals {
    font-size: 12px;
    margin-top: 6px;
  }

  .toast {
    font-size: 12px;
    padding: 6px 12px;
    /* 提示浮层改到手牌条（出牌器）**上方**：fixed 的 bottom 要跨过整个操作区
       （状态行 15px + 间距 2px + 手牌条 68px + 页脚 padding 4px + 6px 间隙），
       并叠上 iPhone 底部安全区。盖住的是牌桌下沿的牌河（提示 3s 自动消失）。 */
    bottom: calc(95px + env(safe-area-inset-bottom, 0px));
  }
}

/*
 * 窄横屏（≤700 CSS px）：**手牌相关的一条都不写**。
 * 这里曾经放着一份 39×55 / 21·10·23 的缩小档，断点按**窗口宽**判断；而手牌条宽度
 * 绑 canvasW（2:1 反算），844px 的横屏手机命中不了 700px 档、牌却照样放不下 ——
 * 两个真相互相补不齐（用户报「手牌为啥还能滑动」）。
 * 2026-10-21 起牌位/字号由 handMetrics 按实测条宽统一下发（CSS 变量），所有宽度
 * 一份真相；此档只保留与手牌无关的控件尺寸。
 */
@media (max-width: 700px) {
  .controls button {
    height: 28px;
    line-height: 26px;
    font-size: 12px;
    padding: 0 10px;
    margin: 0 2px;
  }
  /* 回落钮同步收紧（主规则特异度更高，媒体查询里要同特异度重写才压得动） */
  .controls .ctrl:not(.art):not(.declare) {
    height: 28px;
    padding: 0 10px;
    font-size: 12px;
  }
}