    padding: 5px 8px;
  }

  .chat-chip {
    height: 26px;
    line-height: 24px;
    font-size: 11px;
    padding: 0 8px;
  }

  .chat-input-row {
    padding: 4px 6px;
    gap: 4px;
  }

  .chat-ico {
    width: 28px !important;
