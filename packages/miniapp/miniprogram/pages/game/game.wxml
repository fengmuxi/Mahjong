<!-- 掷骰覆盖层是两页共用的模板（样式在 app.wxss），import 必须在文件顶层 -->
<import src="/templates/dice.wxml" />

<view class="{{pageLeaving ? 'page-leaving' : ''}} page game bg-cloud" style="--safe-l:{{safeL}}px; --safe-r:{{safeR}}px; --safe-t:{{safeT}}px">
  <!-- 刘海/挖孔探测元素：宽/高直接写成 env(safe-area-inset-left/right/top)，
       computeSafeInsets 用 SelectorQuery 把它量回来 —— 量到的就是当前运行时里
       env() 的真实解析值（0 尺寸、不可见，不影响布局与点击）。
       注意顶部探测元素量的是**高度**（#safe-probe-t），左右两侧量的是宽度。 -->
  <view id="safe-probe-l" class="safe-probe"></view>
  <view id="safe-probe-r" class="safe-probe"></view>
  <view id="safe-probe-t" class="safe-probe"></view>
  <view class="banner" wx:if="{{netShown}}">{{netText}}</view>

  <!--
    整屏桌面（2026-10-22「牌桌铺满 + 手牌坐在桌上」）：
    绿绒龙纹桌铺满整个页面（含顶栏、两侧按钮轨、底部手牌条底下），
    画布那一块由 canvas 用**同一个矩形**画同一张图，两层像素级对齐 → 看不出接缝。
    用 <image mode="scaleToFill"> 而不是 WXSS 的 background-image：
      · 走的是**和手牌牌面同一条链路**（<image src> / downloadFile 合法域名 + 微信侧缓存），
        牌面能显示，这一层就一定能显示，少一个排查变量；
      · scaleToFill 就是「非等比拉满」，与 canvas 侧 drawImage 的整铺映射完全一致。
    拿不到桌面图（清单未就绪 / 部署漏带 public/ui）时退成纯色块：
    UI 整通道失败退成矢量桌的藏青，免得画布里藏青桌 + 页面绿绒两块桌面拼在一起。
    z-index:0 + pointer-events:none：纯背景，不参与点击。
  -->
  <image wx:if="{{feltUrl}}" class="felt" src="{{feltUrl}}" mode="scaleToFill"></image>
  <view wx:else class="felt {{feltNavy ? 'na' : ''}}"></view>

  <!--
    自绘顶栏（2026-10-21，game.json navigationStyle=custom）：
    原来这里是「原生导航栏(44px) + HUD(30px)」两行，现在合成一行 28px 的极简信息条，
    牌桌高度净赚 ~44px（这就是「放大中心牌面区域」）。右侧留 CAPSULE_W 给系统胶囊。
  -->
  <view class="g-top">
    <!-- 返回 = 解散对局：本项目的页面跳转全是 redirectTo（room.js 的跳转合并），
         没有可 navigateBack 的栈；且中途离桌服务端会把 `game` 广播回来、人又被拽回
         牌桌（room.js 的自愈逻辑）。所以「离开」只能走 abort，与右轨 ✕ 同一确认框。 -->
    <view class="g-top-back" bindtap="onAbort">‹</view>
    <view class="g-top-info">
      <text class="badge">{{variantLabel}}</text>
      <text class="code">{{code}}</text>
      <text class="g-top-item">{{wallText}}</text>
      <text class="g-top-item jing" wx:if="{{jingText}}">{{jingText}}</text>
    </view>
    <view class="g-top-cap"></view>
  </view>

  <!--
    牌桌独占整行（2026-10-21 重排）：记录 / 聊天从流内三栏改成**侧边按钮 + 弹窗**，
    左边一枚 📋、右边 💬/🤖/🎯/✕，全部 absolute 浮在画布两侧的空白区上（不占流宽）。
    轨绝不压画布矩形 —— fitCanvas 的 min(行宽−84, 行高×2) 保证画布两侧各留 ~42px。
  -->
  <view class="game-main" id="game-main">
    <view class="rail rail-l" wx:if="{{!diceShown}}">
      <button class="rail-btn {{logOpen ? 'on' : ''}}" bindtap="onToggleLog">📋</button>
    </view>

    <view class="canvas-wrap" id="canvas-wrap">
      <canvas
        id="table"
        type="2d"
        class="{{modalOpen || panelOpen ? 'on-modal' : ''}}"
        style="width: {{canvasW}}px; height: {{canvasH}}px;"
        bindtap="onCanvasTap"
      ></canvas>
    </view>

    <view class="rail rail-r" wx:if="{{!diceShown}}">
      <button class="rail-btn {{chatOpen ? 'on' : ''}}" bindtap="onToggleChat">💬<text class="rail-badge" wx:if="{{chatUnread > 0}}">{{chatUnread > 99 ? '99+' : chatUnread}}</text></button>
      <button class="rail-btn {{autoOn ? 'on' : ''}}" wx:if="{{autoShown}}" bindtap="onAuto">🤖</button>
      <button class="rail-btn" bindtap="onEmoteOpen">🎯</button>
      <button class="rail-btn danger" wx:if="{{dissolveGameShown}}" bindtap="onAbort">✕</button>
    </view>

    <!-- 记录面板（左轨 📋 触发）：absolute 盖在牌桌区，不遮底部手牌条 -->
    <view class="side-panel" wx:if="{{logOpen}}">
      <view class="panel-card log-card">
        <view class="panel-head">
          <text class="panel-title">操作记录</text>
          <button class="panel-x" bindtap="onToggleLog">✕</button>
        </view>
        <scroll-view class="panel-body" scroll-y scroll-top="{{logScrollTop}}">
          <view wx:for="{{logRows}}" wx:key="seq" class="log-row">
            <text class="log-seat">{{item.seatName}}</text>
            <text class="log-action {{item.actionClass}}">{{item.action}}</text>
            <text class="log-tiles" wx:if="{{item.tiles}}">{{item.tiles}}</text>
            <text class="log-note" wx:if="{{item.note}}">{{item.note}}</text>
          </view>
        </scroll-view>
      </view>
    </view>

    <!-- 聊天面板（右轨 💬 触发）：快捷语 / 表情 / 输入行，与旧窄屏面板同一套组件 -->
    <view class="side-panel" wx:if="{{chatOpen}}">
      <view class="panel-card chat-card">
        <view class="panel-head">
          <text class="panel-title">聊天</text>
          <button class="panel-x" bindtap="onToggleChat">✕</button>
        </view>
        <scroll-view class="chat-log" scroll-y scroll-into-view="chat-end">
          <view wx:for="{{chatMsgs}}" wx:key="*this" class="chat-msg {{item.self ? 'self' : ''}}">
            <text class="chat-name">{{item.name}}：</text><text class="chat-text">{{item.text}}</text>
          </view>
          <view id="chat-end"></view>
        </scroll-view>
        <scroll-view class="chat-pop" scroll-y wx:if="{{quickShown}}">
          <view class="chat-pop-row">
            <button wx:for="{{quickList}}" wx:key="*this" class="chat-chip" data-text="{{item}}" bindtap="onQuickTap">{{item}}</button>
          </view>
        </scroll-view>
        <scroll-view class="chat-pop" scroll-y wx:if="{{emojiShown}}">
          <view class="chat-pop-row">
            <button wx:for="{{emojiList}}" wx:key="*this" class="chat-chip" data-text="{{item}}" bindtap="onEmojiTap">{{item}}</button>
          </view>
        </scroll-view>
        <view class="chat-input-row">
          <button class="chat-ico" data-pop="quick" bindtap="onTogglePop">💬</button>
          <button class="chat-ico" data-pop="emoji" bindtap="onTogglePop">😊</button>
          <input
            class="chat-input"
            value="{{chatInput}}"
            maxlength="{{chatMax}}"
            placeholder="说点什么…"
            bindinput="onChatInput"
            bindconfirm="onSendChat"
            adjust-position="{{true}}"
            cursor-spacing="20"
            confirm-type="send"
          />
          <button class="primary chat-send" bindtap="onSendChat">发送</button>
        </view>
      </view>
    </view>
  </view>

  <!--
    底部操作区：提示 → 吃碰杠胡 → 手牌，三者**在画布下方流内排布**，不覆盖牌桌。
    为什么不放画布里盖着（2026-10-17 实测否决）：<canvas type="2d"> 是原生组件，
    合成层级在所有 DOM 之上，普通 view 会被盖住且点不到，只能用 cover-view；
    但开发者工具里 cover-view 同样盖不住 canvas —— 实时 DOM 里 board-overlay /
    cover-view / tile-btn 全部渲染（14 个牌位都在）却完全不可见，整块操作区消失。
    真机行为未验证、不可依赖，故改为流内：画布仍拿到除操作区以外的全部高度，
    且三个诉求（棋牌更占屏、手牌居中、提示在手牌上方）都能满足。
    顺序（自上而下）：错误 → 状态行（右侧可挂「本局结算 ▲」） → 吃碰杠胡 → 手牌。
    结算态只剩状态行一行，其余高度全给画布（用户报「结算时麻将区域应该放大」）。
  -->
  <!--
    2026-10-20「出血对齐」→ 2026-10-21 自适应：操作区宽度由 fitCanvas 的 handMetrics
    算出（`handTrayW`），而不是直接绑 canvasW。
    为什么改：画布宽 = min(行宽, 行高×2)，手机横屏行高只有 ~200px → 画布被压到 ~410px，
    比 14 张手牌排满所需的 679px 窄得多，手牌条只能横向滚动（用户报「还能滑动」）。
    现在规则是「画布宽与 14 张排满所需取大、再被行宽截断」：PC/平板与画布同宽（旧行为），
    手机横屏放宽到 679px 做满宽手牌带，行宽还不够就把牌位同比缩小（见 handMetrics）——
    任何横屏窗口都不靠滚动看全，状态行 / 吃碰杠胡遮罩 / 手牌条与画布仍左右对齐居中。
  -->
  <view class="board-overlay" wx:if="{{!modalOpen}}" style="width: {{handTrayW}}px; margin: 0 auto;">
    <!--
      状态行**恒占一行**（不再随控件出现/消失增删）：
      之前用 wx:if 藏起来，控件一出现这行就消失 → 操作区总高变化 → 画布重排跳动
      （用户报「报杠提示把牌桌往上顶、样式变形」）。
      错误提示也塞进这一行（占位替换状态文案，而不是另起一行）：
      它原先是一个独立的 `.g-error` 行，一出现就把操作区顶高一行 —— 线上旧服务端
      每 10s 回一条「未知消息」，画面就每 10s 抖一次（用户报「未知消息导致布局变化」）。
      响应倒计时也在这行右侧；结算态再挂「本局结算 ▲」。
    -->
    <view class="g-status {{overPhase ? 'over' : ''}}">
      <text class="g-status-text err" wx:if="{{controlsErrShown}}">⚠ {{controlsErrText}}</text>
      <text class="g-status-text" wx:else>{{statusText}}</text>
      <text class="countdown" wx:if="{{countdownShown}}">{{countdownText}}</text>
      <view class="settle-restore" wx:if="{{settleRestoreShown}}" bindtap="onSettleRestore">本局结算 ▲</view>
    </view>

    <!--
      操作区（相对定位）：手牌常驻底层，吃碰杠胡时用半透明遮罩盖在手牌上。
      结算态（overPhase）整块不渲染 —— 手牌已无意义，腾出的高度留给牌桌放大。
    -->
    <view class="tray-stack" wx:if="{{!overPhase}}">
      <!-- 手牌：吃碰杠胡选择期也显示（不看手牌没法判断该碰还是该胡）
           2026-10-21：牌位/字号由 handMetrics 经 CSS 变量下发（--tw/--th/…），
           整排永远排得进条宽；scroll-x 只在极端窄窗（< HAND_MIN_W 也放不下 14 张，
           如 iPad 分屏）才真正滚得动，bounces=false 关掉 iOS「内容放得下也能拽一下」的回弹。 -->
      <scroll-view class="hand-tray {{trayActive ? 'active' : ''}}" scroll-x bounces="{{false}}" wx:if="{{trayShown}}">
        <view class="tray-row" style="--tw:{{handTileW}}px; --th:{{handTileH}}px; --ml-drawn:{{handMlDrawn}}px; --fs-rank:{{handFsRank}}px; --fs-suit:{{handFsSuit}}px; --fs-honor:{{handFsHonor}}px">
          <view
            wx:for="{{tray}}"
            wx:key="key"
            class="tile-btn tone-{{item.tone}} {{item.drawn ? 'drawn' : ''}} {{item.frozen ? 'frozen' : ''}} {{item.must ? 'must' : ''}} {{item.pi ? 'pi' : ''}} {{item.fu ? 'fu' : ''}}"
            data-tile="{{item.tile}}"
            bindtap="onTrayTap"
          >
            <!--
              牌面优先级：**CDN 图片 → 矢量文字**。
              图片来自后端 `/api/tiles` 清单（代码包零图片，见 utils/tileimg.js）；
              没取到清单、或单张加载失败（binderror 会把该张的 cdn 置空），
              就落回矢量牌面 —— 风箭牌只画一个字，数牌画「数字 + 花色」。
            -->
            <image
              wx:if="{{item.cdn}}"
              class="tile-img"
              src="{{item.cdn}}"
              mode="aspectFill"
              data-tile="{{item.tile}}"
              binderror="onTileImgError"
            ></image>
            <block wx:else>
              <block wx:if="{{item.honor}}">
                <text class="tile-honor">{{item.suitChar}}</text>
              </block>
              <block wx:else>
                <text class="tile-rank">{{item.rank}}</text>
                <text class="tile-suit">{{item.suitChar}}</text>
              </block>
            </block>
          </view>
        </view>
      </scroll-view>

      <!--
        吃 / 碰 / 杠 / 胡 / 过：**半透明遮罩盖在手牌上**。
        为什么能盖住：遮罩与手牌都是普通 DOM，DOM 之间互相覆盖不受原生 canvas 限制
        （canvas 只挡在它自己的矩形上方，这里已在其下方区域）。
        遮罩用 rgba 让手牌透出来 —— 用户要看牌决定碰还是胡。
      -->
      <view class="claim-mask" wx:if="{{controls.length > 0}}">
        <view class="controls">
          <button
            wx:for="{{controls}}"
            wx:key="text"
            class="ctrl {{item.ghost ? '' : 'primary'}} {{item.disabled ? 'disabled' : ''}} {{item.art ? 'art' : ''}} {{ctrlCompact ? 'compact' : ''}}"
            disabled="{{item.disabled}}"
            data-idx="{{index}}"
            bindtap="onControl"
          >
            <!-- 有 CDN 艺术图（吃/碰/杠/胡/过）时：图 + 压在图下缘的小注（牌名/牌型）。
                 清单未就绪时整块退回纯文字钮，行为与旧版一致。 -->
            <image wx:if="{{item.art}}" class="ctrl-img" src="{{item.art}}" mode="aspectFit"></image>
            <text wx:if="{{item.art && item.cap}}" class="ctrl-cap">{{item.cap}}</text>
            <block wx:else>{{item.text}}</block>
          </button>
        </view>
      </view>
    </view>
  </view>

  <!-- 掷骰覆盖层（与大厅共用模板 templates/dice.wxml；样式在 app.wxss） -->
  <template is="dice" data="{{diceShown, diceMsg, dice}}" />

  <!-- 互动表情面板 -->
  <view class="layer" wx:if="{{emoteShown}}">
    <view class="layer-card emote-card">
      <view class="layer-title">互动表情</view>
      <view class="layer-text">先点一位玩家，再点一个表情给他；所有玩家都能看到。</view>
      <view class="emote-targets">
        <button
          wx:for="{{emoteTargets}}"
          wx:key="seat"
          class="emote-target {{item.active ? 'on' : ''}}"
          data-seat="{{item.seat}}"
          bindtap="onEmoteTarget"
        >{{item.label}}</button>
      </view>
      <scroll-view class="emote-grid" scroll-y>
        <block wx:for="{{emoteGroups}}" wx:key="label">
          <view class="emote-group {{item.tone}}">{{item.label}}</view>
          <view class="emote-cells">
            <button
              wx:for="{{item.cells}}"
              wx:for-item="cell"
              wx:key="id"
              class="emote-cell {{item.tone}}"
              data-id="{{cell.id}}"
              bindtap="onEmoteCell"
            >
              <text class="ico">{{cell.icon}}</text><text>{{cell.name}}</text>
            </button>
          </view>
        </block>
      </scroll-view>
      <view class="btn-row end">
        <button bindtap="onEmoteClose">关闭</button>
      </view>
    </view>
  </view>

  <!-- 结算面板 -->
  <view class="layer" wx:if="{{settleShown}}">
    <view class="layer-card settle-card">
      <!-- 结算艺术字（胜利/失败/平局，CDN；未就绪不渲染，标题文字独自成立） -->
      <image wx:if="{{settleArt}}" class="settle-art" src="{{settleArt}}" mode="aspectFit"></image>
      <view class="layer-title">{{settleTitle}}</view>
      <scroll-view class="settle-body" scroll-y scroll-x>
        <view class="tbl">
          <view class="tbl-row head">
            <view class="tbl-cell" wx:for="{{settleHead}}" wx:key="*this">{{item}}</view>
          </view>
          <view wx:for="{{settleRows}}" wx:key="*this" class="tbl-row {{item.me ? 'me' : ''}}">
            <view
              wx:for="{{item.cells}}"
              wx:for-item="cell"
              wx:key="*this"
              class="tbl-cell {{cell.cls}}"
            >{{cell.text}}</view>
          </view>
        </view>
        <view wx:for="{{settleNotes}}" wx:key="*this" class="settle-note">{{item}}</view>
      </scroll-view>
      <view class="settle-totals">{{settleTotals}}</view>
      <view class="btn-row end">
        <button bindtap="onSettleHide">最小化</button>
        <button class="primary" disabled="{{settleNextDisabled}}" bindtap="onSettleNext">下一局</button>
      </view>
    </view>
  </view>

  <!-- 解散对局二次确认：页内浮层，不用 wx.showModal（原生模态框在部分环境下不弹/回调不达，
       表现是「点了解散毫无反应」且无任何提示；页内浮层与其它确认框同构、可测） -->
  <view class="layer" wx:if="{{abortAskShown}}">
    <view class="layer-card">
      <view class="layer-title">解散对局</view>
      <view class="layer-text">将强制结束本局并返回准备界面（房间保留，可重新开局；本局不计分）。</view>
      <view class="btn-row end">
        <button data-accept="0" bindtap="onAbortConfirm">取消</button>
        <button class="primary" data-accept="1" bindtap="onAbortConfirm">解散</button>
      </view>
    </view>
  </view>

  <!-- 换位请求 -->
  <view class="layer" wx:if="{{swapAskShown}}">
    <view class="layer-card">
      <view class="layer-title">换位请求</view>
      <view class="layer-text">{{swapAskText}}</view>
      <view class="btn-row end">
        <button data-accept="0" bindtap="onSwapRespond">拒绝</button>
        <button class="primary" data-accept="1" bindtap="onSwapRespond">同意</button>
      </view>
    </view>
  </view>

  <!-- 解散：最终积分 -->
  <view class="layer" wx:if="{{dissolvedShown}}">
    <view class="layer-card">
      <view class="layer-title">{{dissolvedTitle}}</view>
      <view class="tbl">
        <view class="tbl-row head">
          <view class="tbl-cell">玩家</view>
          <view class="tbl-cell">总积分</view>
        </view>
        <view wx:for="{{dissolvedRows}}" wx:key="name" class="tbl-row">
          <view class="tbl-cell">{{item.name}}</view>
          <view class="tbl-cell total-col {{item.value > 0 ? 'pos' : item.value < 0 ? 'neg' : ''}}">{{item.value > 0 ? '+' : ''}}{{item.value}}</view>
        </view>
      </view>
      <view class="btn-row end">
        <button class="primary" bindtap="onDissolvedOk">关闭</button>
      </view>
    </view>
  </view>

  <view class="toast" wx:if="{{toastShown}}">{{toastText}}</view>
</view>