.home-card {
  max-width: 1100rpx;
  align-self: center;
  width: 100%;
}

.banner {
  margin-bottom: 12rpx;
  padding: 10rpx 16rpx;
  border-radius: 10rpx;
  background: rgba(224, 122, 106, 0.16);
  color: #e07a6a;
  font-size: 24rpx;
}

/* ---------- 步骤条 ---------- */
.steps {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
  flex-wrap: wrap;
}

.step-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.1);
  font-size: 24rpx;
  color: #9db5a8;
}

.step-item.current {
  border-color: #e6c14b;
  color: #f6e3a1;
}

.step-item.done {
  border-color: rgba(67, 192, 124, 0.5);
  color: #43c07c;
}

.step-dot {
  width: 32rpx;
  height: 32rpx;
  line-height: 30rpx;
  text-align: center;
  border-radius: 50%;
  border: 2rpx solid currentColor;
  font-size: 20rpx;
}

/* ---------- 主体：默认（高视口）单列；矮视口见底部 @media ---------- */
.home-body {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
}

.home-main {
  min-width: 0;
}

.home-aside {
  display: flex;
  flex-direction: row;
  align-items: flex-end;
  justify-content: space-between;
  gap: 16rpx;
  flex-wrap: wrap;
  margin-top: auto;
}

.home-head {
  font-size: 32rpx;
  font-weight: 700;
  color: #f6e3a1;
  margin-bottom: 16rpx;
}

/* ---------- 第 ① 步 ---------- */
.mode-cards {
  display: flex;
  gap: 16rpx;
}

.mode-card {
  flex: 1;
  padding: 24rpx;
  border-radius: 14rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.12);
  background: rgba(255, 255, 255, 0.03);
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.mode-card:active {
  background: rgba(230, 193, 75, 0.12);
}

.mode-icon {
  font-size: 40rpx;
  color: #e6c14b;
}

.mode-title {
  font-size: 30rpx;
  font-weight: 700;
}

.mode-desc {
  font-size: 22rpx;
  color: #9db5a8;
}

/* ---------- 第 ② 步：玩法卡 ---------- */
.variants {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
}

.variant {
  flex: 1;
  min-width: 280rpx;
  padding: 20rpx;
  border-radius: 14rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.12);
  background: rgba(255, 255, 255, 0.03);
}

.variant.active {
  border-color: #e6c14b;
  background: rgba(230, 193, 75, 0.12);
}

.variant-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #f6e3a1;
}

.variant-desc {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #9db5a8;
}

.variant-tags {
  margin-top: 10rpx;
  display: flex;
  gap: 8rpx;
  flex-wrap: wrap;
}

.variant-tags text {
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.07);
  font-size: 20rpx;
  color: #b9cfc2;
}

/* ---------- 最后一步：表单 ---------- */
.form-summary {
  display: flex;
  gap: 10rpx;
  flex-wrap: wrap;
  margin-bottom: 16rpx;
}

.chip {
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(230, 193, 75, 0.12);
  color: #f6e3a1;
  font-size: 22rpx;
}

.field {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.field-label {
  width: 120rpx;
  font-size: 26rpx;
  color: #9db5a8;
}

.field-input {
  flex: 1;
  height: 72rpx;
  padding: 0 20rpx;
  border-radius: 10rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.16);
  background: rgba(0, 0, 0, 0.25);
  color: #e8efe9;
  font-size: 28rpx;
}

.code-input {
  letter-spacing: 4rpx;
  text-transform: uppercase;
}

.btn-row.end {
  justify-content: flex-end;
  margin-top: 8rpx;
}

/* ---------- 背景切换 ---------- */
.bg-switch {
  margin-top: 20rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.bg-switch-label {
  font-size: 24rpx;
  color: #9db5a8;
}

.bg-opts {
  display: flex;
  gap: 8rpx;
  flex-wrap: wrap;
}

.bg-opt {
  height: 56rpx;
  line-height: 52rpx;
  padding: 0 18rpx;
  font-size: 22rpx;
}

/*
 * 矮视口（手机横屏：高 ≤ ~430px；含开发者工具里被压矮的模拟窗口）：
 * 全部改用 px 定尺 —— rpx 随屏宽放大，在「宽而矮」的窗口里会把字号/间距一起撑爆，
 * px 不随宽度缩放，预算才可算。布局改左右分栏：左=当前步骤，右=说明+背景切换。
 */
@media (max-height: 680px) {
  .page {
    padding: 8px 12px calc(8px + env(safe-area-inset-bottom, 0px));
  }

  .banner {
    margin-bottom: 6px;
    padding: 4px 10px;
    font-size: 11px;
  }

  .home-card {
    padding: 10px 12px;
    max-width: 1000px;
  }

  .steps {
    gap: 8px;
    margin-bottom: 10px;
  }

  .step-item {
    padding: 3px 10px;
    font-size: 12px;
  }

  .step-dot {
    width: 18px;
    height: 18px;
    line-height: 16px;
    border-width: 1px;
    font-size: 11px;
  }

  .home-body {
    flex-direction: row;
    gap: 14px;
  }

  .home-main {
    flex: 1;
    min-width: 0;
  }

  .home-head {
    font-size: 15px;
    margin-bottom: 8px;
  }

  .mode-cards {
    gap: 10px;
  }

  .mode-card {
    padding: 12px;
    gap: 4px;
    border-radius: 8px;
  }

  .mode-icon {
    font-size: 20px;
  }

  .mode-title {
    font-size: 14px;
  }

  .mode-desc {
    font-size: 11px;
  }

  .variants {
    gap: 8px;
  }

  .variant {
    min-width: 140px;
    padding: 8px 10px;
    border-radius: 8px;
  }

  .variant-name {
    font-size: 13px;
  }

  .variant-desc {
    font-size: 11px;
    margin-top: 2px;
  }

  .variant-tags {
    margin-top: 4px;
    gap: 4px;
  }

  .variant-tags text {
    padding: 1px 6px;
    font-size: 10px;
  }

  .form-summary {
    gap: 6px;
    margin-bottom: 8px;
  }

  .chip {
    padding: 2px 10px;
    font-size: 11px;
  }

  .field {
    gap: 8px;
    margin-bottom: 8px;
  }

  .field-label {
    width: 56px;
    font-size: 12px;
  }

  .field-input {
    height: 30px;
    padding: 0 8px;
    font-size: 13px;
  }

  .btn-row button {
    height: 32px;
    line-height: 30px;
    padding: 0 12px;
    font-size: 13px;
  }

  .btn-row.end {
    margin-top: 6px;
  }

  .error {
    font-size: 12px;
    margin-top: 4px;
  }

  .home-aside {
    width: 200px;
    flex-shrink: 0;
    flex-direction: column;
    align-items: stretch;
    justify-content: flex-end;
    gap: 8px;
    margin-top: 0;
  }

  .hint {
    font-size: 11px;
    line-height: 1.4;
    margin-top: 0;
  }

  .bg-switch {
    margin-top: 0;
    gap: 8px;
  }

  .bg-switch-label {
    font-size: 11px;
  }

  .bg-opt {
    height: 28px;
    line-height: 26px;
    padding: 0 10px;
    font-size: 11px;
  }

  /* 浮层（换位 / 解散 / toast） */
  .layer-card {
    width: 88%;
    padding: 14px 16px;
  }

  .layer-title {
    font-size: 15px;
    margin-bottom: 8px;
  }

  .layer-text {
    font-size: 12px;
    margin-bottom: 12px;
  }

  .tbl-row {
    font-size: 12px;
  }

  .toast {
    font-size: 12px;
    padding: 6px 12px;
    bottom: 20px;
  }
}
